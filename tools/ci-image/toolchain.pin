# The Haskell toolchain the Linux CI image installs, pinned to upstream
# binary distributions and their SHA-256 checksums. The versions must equal the
# GHC_VERSION and CABAL_VERSION the validation workflow pins; the builder
# refuses to publish an image whose installed compilers disagree with them.
# Qualified on both platforms by issue #157; see docs/toolchain.md.
GHC_VERSION=9.14.1
GHC_URL=https://downloads.haskell.org/~ghc/9.14.1/ghc-9.14.1-x86_64-ubuntu24_04-linux.tar.xz
GHC_SHA256=530f0861d1d7b45476c158a9e68aa89987687aaf9939df7a15995c45726e2344
# Upstream publishes no distribution-specific cabal-install bindist for this
# release; `-unknown` is the portable x86_64 Linux build.
CABAL_VERSION=3.18.1.0
CABAL_URL=https://downloads.haskell.org/~cabal/cabal-install-3.18.1.0/cabal-install-3.18.1.0-x86_64-linux-unknown.tar.xz
CABAL_SHA256=c6385c155ff61f792dfed0e8c101004db63f8d8b556dd6c9838f81a012bf28a6
