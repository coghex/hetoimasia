cabal-version: 3.16
name: hetoimasia-test-support
version: 0.1.0.0
synopsis: Neutral utilities shared by Hetoimasia's test suites
description:
    A test-only library holding what more than one independently built test
    suite needs: the external-client compiler harness the opacity examples use
    to prove what a package boundary exposes, a bounded wait, and the owned
    helper thread every test that starts a thread uses (with the cancellation
    and parked-release orchestrations built on it). It registers no examples,
    depends on no engine package, initializes nothing native, and holds no
    global fixture. Only test suites may depend on it.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Testing
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md
extra-source-files: cbits/hetoimasia_test_support_process.h

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: tools/test-support

library
    exposed-modules:
        Test.Support.Bounded
        Test.Support.Cancel
        Test.Support.ExternalClient
        Test.Support.Owned
        Test.Support.Parked
        Test.Support.Subprocess
        Test.Support.Subprocess.Host
    hs-source-dirs: src
    c-sources: cbits/hetoimasia_test_support_process.c
    include-dirs: cbits
    install-includes: hetoimasia_test_support_process.h
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9
