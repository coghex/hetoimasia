{
  "schema_version": 1,
  "policy_version": 10,
  "policy_inputs": [
    "tools/validation/",
    ".github/workflows/"
  ],
  "non_affecting_paths": [
    "*.md",
    ".editorconfig",
    ".gitignore",
    "LICENSE",
    "tools/KANBAN-LICENSE"
  ],
  "generated_paths": [
    "dist-newstyle/",
    "dist-dev/",
    ".worktrees/",
    "captures/",
    "plan.json",
    "plan.err",
    "applicability.json",
    "request.txt",
    "reuse.out",
    "receipts/",
    "*.pyc",
    "*.DS_Store"
  ],
  "floor": [
    "build.all",
    "test.engine",
    "test.foundation",
    "test.runtime",
    "test.glfw",
    "smoke.console"
  ],
  "groups": [
    {
      "id": "build.all",
      "description": "Compile every local component warning-clean.",
      "command": [
        "cabal",
        "build",
        "all"
      ],
      "component": "all",
      "inputs": [],
      "framework": "none",
      "runner": "cpu",
      "timeout_seconds": 3600,
      "category": "build",
      "optional": false
    },
    {
      "id": "test.engine",
      "description": "Focused Hspec examples for the root package's console startup and exit integration.",
      "command": [
        "cabal",
        "test",
        "hetoimasia-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia:test:hetoimasia-tests",
      "inputs": [],
      "framework": "hspec",
      "runner": "cpu",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    },
    {
      "id": "test.foundation",
      "description": "Focused Hspec examples for the foundation package's Logging, Resources, Failures, Recovery, Workers, Messaging, and Time contracts.",
      "command": [
        "cabal",
        "test",
        "hetoimasia-foundation:foundation-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia-foundation:test:foundation-tests",
      "inputs": [],
      "framework": "hspec",
      "runner": "cpu",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    },
    {
      "id": "test.runtime",
      "description": "Focused Hspec examples for the runtime package's application runner and lifecycle, logging lifetime, reporting, supervision, inbox services, package boundaries, resource smoke, and supervised messaging waits.",
      "command": [
        "cabal",
        "test",
        "hetoimasia-runtime:runtime-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia-runtime:test:runtime-tests",
      "inputs": [],
      "framework": "hspec",
      "runner": "cpu",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    },
    {
      "id": "test.glfw",
      "description": "Headless Hspec examples for the GLFW package's session, window, command, control, host, dynamic window, monitor, input, and mode models over the test seam, its link declarations against the native manifest, and its package boundaries. Initializes no GLFW and needs no display.",
      "command": [
        "cabal",
        "test",
        "hetoimasia-glfw:glfw-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia-glfw:test:glfw-tests",
      "inputs": [
        "tools/ci-image/",
        "tools/native/"
      ],
      "framework": "hspec",
      "runner": "cpu",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    },
    {
      "id": "smoke.console",
      "description": "Run the console executable's smoke mode end to end.",
      "command": [
        "cabal",
        "run",
        "exe:hetoimasia",
        "--",
        "--smoke"
      ],
      "component": "hetoimasia:exe:hetoimasia",
      "inputs": [],
      "framework": "none",
      "runner": "cpu",
      "timeout_seconds": 900,
      "category": "smoke",
      "optional": false
    },
    {
      "id": "test.workflow",
      "description": "Hspec examples driving the documentation landing helper, this planner, the CI image builder, the native recipe helper, and the isolated X11 display helper against temporary Git repositories.",
      "command": [
        "cabal",
        "test",
        "workflow-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia:test:workflow-tests",
      "inputs": [
        "tools/ci-image/",
        "tools/display/",
        "tools/docs_land.sh",
        "tools/docs_land_paths.py",
        "tools/native/",
        "tools/validation/"
      ],
      "framework": "hspec",
      "runner": "cpu",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    },
    {
      "id": "test.glfw-native",
      "description": "Real GLFW session, thread, and window examples through the shared native Hspec fixture, on an isolated X11 display.",
      "command": [
        "cabal",
        "test",
        "glfw-native-tests",
        "--test-show-details=direct"
      ],
      "component": "hetoimasia-glfw:test:glfw-native-tests",
      "inputs": [
        "tools/ci-image/",
        "tools/display/",
        "tools/native/"
      ],
      "framework": "hspec",
      "runner": "display",
      "timeout_seconds": 1800,
      "category": "test",
      "optional": false
    }
  ]
}
