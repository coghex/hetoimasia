-- The Vulkan project: the VK-2 proof harness, the native backend package, and
-- the GLFW package with its Vulkan interop component enabled — the only project
-- file that names the first two or turns that component on.
--
-- `cabal.project` and `cabal.project.cpu` deliberately do not list
-- `tools/vulkan-proof` or `packages/gpu-vulkan/native`, and neither sets the
-- GLFW package's manual `vulkan-interop` flag, so neither resolves nor links the
-- Vulkan binding and neither `cabal build all` nor `cabal build all
-- --project-file cabal.project.cpu` needs a loader or the Vulkan headers. Every
-- mandatory validation group runs through one of those two, so the floor never
-- builds this. The other packages here are the local dependency closure of the
-- native package and of the interop component — the diagnostics package whose C
-- capture the native package installs, the GPU model, the runtime the GLFW
-- package's runtime integration uses, the foundation, and the test-only support
-- library the native package's shader suite uses — which the ordinary projects
-- list too; `cabal.project` lists the GLFW package itself, with the flag off.
-- Selecting this project is an explicit act:
--
--   bash tools/vulkan-proof/run-proof.sh
--   bash tools/vulkan-proof/run-shaders.sh
--
-- which is also what points the build at the loader: the native prefix
-- `tools/native/vulkan.py` provisions carries it, and the runner passes that
-- prefix's link and include directories on the command line. No project file is
-- generated, here or beside this one. See docs/validation.md and
-- docs/vulkan_compatibility_record.md.
import: cabal.project.common

packages:
  tools/vulkan-proof
  packages/gpu-vulkan/native
  packages/glfw
  packages/gpu-vulkan/diagnostics
  packages/gpu-vulkan/model
  packages/runtime
  packages/foundation
  tools/test-support

-- The GLFW package's Vulkan interop component: the shared loader capability and
-- the surface bridge the proof's VK-5 cases exercise. Off everywhere else.
package hetoimasia-glfw
  flags: +vulkan-interop

-- The flags docs/toolchain.md qualified, restated here because a constraint is
-- what actually reaches the dependency: `safe-foreign-calls` so a Vulkan call
-- may re-enter the proof's Haskell debug-utils callback, and `darwin-lib-dirs`
-- off so the loader is the one this repository names rather than whatever sits
-- in /usr/local/lib. `run-proof.sh` checks these against
-- tools/toolchain/binding.pin. They are the native package's build too: a
-- project builds one configuration of the binding, and that package records the
-- flags it is built under, and the C-only capture callback that needs neither,
-- in `nativeFfiConfiguration`, which the proof record prints.
constraints:
    vulkan +safe-foreign-calls,
    vulkan -darwin-lib-dirs

-- Where macOS finds the loader while it compiles. `vulkan-utils`, and every
-- shader splice through it, runs Template Haskell against the compiled binding,
-- so GHC loads the binding's dylib during the build, and that dylib records the
-- loader as `@rpath/libvulkan.1.dylib`. Command-line `--extra-lib-dirs` reach
-- this project's own packages only, never the binding the store builds, so the
-- binding's directory and rpath are named here: the directory `MACOS_LOADER` and
-- `MACOS_INCLUDE` in tools/native/vulkan.pin pin, which `native.py prepare`
-- verifies by digest before any build. This is the configuration
-- `tools/toolchain/qualify-binding.sh` qualified. Executables still link the
-- provisioned prefix's copy, which `run-proof.sh` names ahead of it. Linux needs
-- none of this: the binding finds the loader through the prefix's `vulkan.pc`.
if os(darwin)
  package vulkan
    extra-lib-dirs: /usr/local/lib
    extra-include-dirs: /usr/local/include
    ghc-options: -optl-Wl,-rpath,/usr/local/lib
