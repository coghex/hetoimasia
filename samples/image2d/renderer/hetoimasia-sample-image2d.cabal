cabal-version: 3.16
name: hetoimasia-sample-image2d
version: 0.1.0.0
synopsis: The image2d sample's drawing for Hetoimasia's 2D renderer
description:
    R2D-8's consumer drawing: a committed PNG decoded with the asset package
    and drawn in a world layer and again in a UI layer, and an RGBA8 KTX2 image
    drawn beside it, through the 2D renderer's recorder, texture registry and
    per-window host adapter, with the scene's independent probes and
    window-free evidence. It depends on the 2D renderer and the native backend
    alone and names nothing of the window integration, so the integration's
    native suite can exercise it unchanged, and the sample's executable
    (`hetoimasia-sample-image2d-app`) hands it to the host. Nothing in the
    engine depends on it.
    .
    It is selected only by `cabal.project.vulkan`, so neither `cabal.project`
    nor `cabal.project.cpu` resolves the binding, the Vulkan headers or a
    loader, and only `tools/vulkan/run.sh` builds it.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
-- The committed images the library embeds; `addDependentFile` registers them
-- too, and listing them lets a source distribution carry them.
extra-source-files:
    assets/*.png
    assets/*.ktx2

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: samples/image2d/renderer

library
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Sample.Image2d
        Hetoimasia.Sample.Image2d.Assets
        Hetoimasia.Sample.Image2d.Embed
        Hetoimasia.Sample.Image2d.Evidence
        Hetoimasia.Sample.Image2d.Fixtures
        Hetoimasia.Sample.Image2d.Png
        Hetoimasia.Sample.Image2d.Scene
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        template-haskell >=2.24 && <2.25,
        text >=2.1 && <2.2,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-gpu-vulkan-native ==0.1.0.0,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-2d-vulkan ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0

-- The sample's headless examples: the committed images against the tables
-- that restate them, the registration and swap rule on the sample's own
-- textures, the scene's structure and the evidence's record, with no device,
-- display or GLFW session. Built and run through `tools/vulkan/run.sh test`
-- — the group `test.vulkan-headless`.
test-suite image2d-tests
    type: exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -threaded -rtsopts
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Test.Sample.Image2d.Assets
        Test.Sample.Image2d.Record
        Test.Sample.Image2d.Scene
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hspec >=2.11 && <3,
        text >=2.1 && <2.2,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-sample-image2d
