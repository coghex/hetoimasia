cabal-version: 3.16
name: hetoimasia
version: 0.1.0.0
synopsis: Console bootstrap for a modular Haskell game engine
description:
    Application composition and focused tests for Hetoimasia's foundation
    and runtime libraries. Rendering and Lua integration are planned components.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.12.2
homepage: https://github.com/coghex/hetoimasia
bug-reports: https://github.com/coghex/hetoimasia/issues
extra-doc-files:
    README.md
    MEMORY.md
    AGENTS.md
    CLAUDE.md
    docs/*.md
    tools/README.md
    tools/KANBAN-LICENSE
extra-source-files:
    .github/workflows/ci-image.yml
    .github/workflows/review-gate.yml
    .github/workflows/validation.yml
    tools/ci-image/Dockerfile
    tools/ci-image/builder.py
    tools/ci-image/descriptor.json
    tools/ci-image/provision.sh
    tools/ci-image/registry.py
    tools/ci-image/toolchain.pin
    tools/docs_land.sh
    tools/display/x11.sh
    tools/docs_land_paths.py
    tools/native/glfw.pin
    tools/native/native.py
    tools/validation/ci_image.py
    tools/validation/plan.py
    tools/validation/range.py
    tools/validation/catalog.json
    tools/validation/receipts.py
    tools/validation/reuse.py
    tools/validation/run.py
    tools/validation/aggregate.py
    tools/validation/review_gate.py
    tools/validation/review_provenance.py
    tools/validation/review_replay.py
    tools/validation/timings.py

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

-- The console executable's own modules that the suite drives directly, kept
-- in their own source directory so no source file is shared between components.
library console
    import: language
    visibility: private
    hs-source-dirs: console
    exposed-modules:
        Hetoimasia.Console.Exit
    build-depends:
        base >=4.21 && <4.22

executable hetoimasia
    import: language
    main-is: Main.hs
    hs-source-dirs: app
    ghc-options: -threaded -rtsopts
    build-depends:
        base >=4.21 && <4.22,
        hetoimasia:console,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0

test-suite workflow-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: tools/test
    other-modules:
        ApprovalProvenance
        CiImage
        DismissalStep
        Display
        Execution
        Json
        Packaging
        Reuse
        ReviewGate
        ReviewReplay
        Sandbox
        Timings
        TimingStep
        Validation
    build-depends:
        base >=4.21 && <4.22,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        temporary >=1.3 && <1.4

test-suite hetoimasia-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.Engine.Spec
        Test.Engine.GLFW.Linking
        Test.Engine.GLFW.Opacity
        Test.Engine.GLFW.Session
        Test.Engine.GLFW.Spec
        Test.Engine.GLFW.WindowModel
        Test.Engine.Runtime.Application
        Test.Engine.Runtime.Composition
        Test.Engine.Runtime.Console
        Test.Engine.Runtime.Inbox
        Test.Engine.Runtime.Inbox.Support
        Test.Engine.Runtime.InboxFinish
        Test.Engine.Runtime.Lifetime
        Test.Engine.Runtime.LogFixture
        Test.Engine.Runtime.Messaging
        Test.Engine.Runtime.Opacity
        Test.Engine.Runtime.Reporting
        Test.Engine.Runtime.ResourceSmoke
        Test.Engine.Runtime.Spec
        Test.Engine.Runtime.Supervision
        Test.Engine.Runtime.Supervision.Support
    ghc-options: -threaded -rtsopts
    build-tool-depends: hetoimasia:hetoimasia, hetoimasia-glfw:glfw-window-examples
    build-depends:
        base >=4.21 && <4.22,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        deepseq >=1.5.1 && <1.6,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hetoimasia:console,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        time >=1.14 && <1.15,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw ==0.1.0.0,
        hetoimasia-glfw:seam ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0
