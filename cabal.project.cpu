-- A CPU-only configuration for suites that must build without the GLFW SDK. It
-- shares `cabal.project.common` with `cabal.project` and differs only in leaving
-- out `hetoimasia-glfw`, the one package that needs GLFW. Select it with
-- `--project-file cabal.project.cpu`; see docs/validation.md.
import: cabal.project.common

packages:
  .
  packages/foundation
  packages/runtime
  packages/scripting-lua
  packages/gpu-vulkan/model
  tools/test-support
