import: cabal.project.common

packages:
  .
  packages/foundation
  packages/runtime
  packages/scripting-lua
  packages/glfw
  tools/test-support

package hetoimasia-glfw
  -- The native check is a test suite. Enabling tests for this package alone
  -- makes `cabal build all` compile it from a clean configuration; building it
  -- runs nothing, so no native session is initialized.
  tests: True
