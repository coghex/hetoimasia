-- Settings every project configuration of this repository shares, imported by
-- `cabal.project` and `cabal.project.cpu` so neither carries its own copy of
-- the index pin, the build settings, or the warning policy.

-- The qualified Hackage index baseline (issue #157); advance deliberately.
index-state: 2026-09-18T00:00:00Z
optimization: 2
jobs: $ncpus
-- Keep the existing multi-worktree toolchain's jobserver setting.
semaphore: False

-- Apply strict build policy only to our packages, never dependencies.
package hetoimasia
  ghc-options: -Werror -j

package hetoimasia-foundation
  ghc-options: -Werror -j

package hetoimasia-math
  ghc-options: -Werror -j

package hetoimasia-asset
  ghc-options: -Werror -j

package hetoimasia-asset-image
  ghc-options: -Werror -j

package hetoimasia-runtime
  ghc-options: -Werror -j

package hetoimasia-test-support
  ghc-options: -Werror -j

package hetoimasia-glfw
  ghc-options: -Werror -j

package hetoimasia-gpu-vulkan-model
  ghc-options: -Werror -j

package hetoimasia-gpu-vulkan-diagnostics
  ghc-options: -Werror -j

package hetoimasia-gpu-vulkan-native
  ghc-options: -Werror -j

package hetoimasia-gpu-vulkan-glfw
  ghc-options: -Werror -j

-- The scene3d sample (GRS-10) is held to the same policy. Like the native and
-- integration packages above, it is named only by `cabal.project.vulkan`.
package hetoimasia-sample-scene3d
  ghc-options: -Werror -j

package hetoimasia-sample-scene3d-app
  ghc-options: -Werror -j

package hetoimasia-scripting-lua
  ghc-options: -Werror -j

-- The Lua interpreter is the copy the `lua` package bundles, never one found
-- on the machine: `system-lua` and `pkg-config` would link whatever the
-- developer's PATH happens to offer, which is a different interpreter version
-- per machine. `allow-unsafe-gc` is off because this bridge pushes Haskell
-- functions into Lua, so any VM that has ever held one has a `__gc` metamethod
-- that re-enters the RTS; with the flag on, every allocation that can trigger
-- collection is an `unsafe` import, which is not a context that may re-enter.
-- See packages/scripting-lua/README.md for the audit these settings come from.
package lua
  flags: -system-lua -pkg-config -allow-unsafe-gc

-- The C zlib that JuicyPixels reaches through the `zlib` binding is the copy
-- the `zlib-clib` package bundles, pinned by the index state above, never one
-- found on the machine: `pkg-config` (on by default) would link whichever
-- libz the developer's PATH happens to offer, a different version per
-- machine, which vision V-11 rules out for native inputs, as for Lua above.
package zlib
  flags: +bundled-c-zlib -pkg-config
