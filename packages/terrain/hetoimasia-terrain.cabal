cabal-version: 3.16
name: hetoimasia-terrain
version: 0.1.0.0
synopsis: Checked terrain tile identity and canonical shape geometry for Hetoimasia
description:
    Tile coordinates on three axes with a checked signed 64-bit range, exact
    region and local decomposition by floor division, the sixteen-shape catalog
    with exact quarter-turn rotation, and the canonical unit-cell solid of every
    shape with its faces, face coverage, point membership and ray and segment
    intersection, all in exact rational arithmetic. The library is pure and
    CPU-only: it has no Lua, window, renderer, GPU, runtime or game dependency
    and owns no state, thread or resource.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/terrain

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Terrain.Cell
        Hetoimasia.Terrain.Changes
        Hetoimasia.Terrain.Coordinate
        Hetoimasia.Terrain.Geometry
        Hetoimasia.Terrain.Palette
        Hetoimasia.Terrain.Query
        Hetoimasia.Terrain.Resident
        Hetoimasia.Terrain.Segment
        Hetoimasia.Terrain.Shape
        Hetoimasia.Terrain.Source
    -- The checked representations and the exact polytope arithmetic the public
    -- modules share; a client cannot import them.
    other-modules:
        Hetoimasia.Terrain.Internal.Cell
        Hetoimasia.Terrain.Internal.Changes
        Hetoimasia.Terrain.Internal.Column
        Hetoimasia.Terrain.Internal.Coordinate
        Hetoimasia.Terrain.Internal.Interval
        Hetoimasia.Terrain.Internal.Packed
        Hetoimasia.Terrain.Internal.Polytope
        Hetoimasia.Terrain.Internal.Shape
        Hetoimasia.Terrain.Internal.Source
    build-depends:
        array >=0.5 && <0.6,
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9

-- This package's own contracts, registered as the CPU validation group
-- `test.terrain`. Hspec and QuickCheck are the suite's alone.
test-suite terrain-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    -- The growth examples read the runtime's allocation counters, which exist
    -- only when the program is started with -T.
    ghc-options: -rtsopts "-with-rtsopts=-T"
    other-modules:
        Test.Terrain.Coordinate
        Test.Terrain.Fixtures
        Test.Terrain.Geometry
        Test.Terrain.Growth
        Test.Terrain.Model
        Test.Terrain.Opacity
        Test.Terrain.Query
        Test.Terrain.Resident
        Test.Terrain.Segment
        Test.Terrain.Shape
        Test.Terrain.Source
        Test.Terrain.Spec
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        QuickCheck >=2.15 && <2.19,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0
