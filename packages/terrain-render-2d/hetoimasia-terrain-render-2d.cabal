cabal-version: 3.16
name: hetoimasia-terrain-render-2d
version: 0.1.0.0
synopsis: Pure isometric cutaway planning and picking for Hetoimasia terrain
description:
    The pure planning half of the terrain arena's 2D view (TRA-7): the exact,
    rebased isometric projection of the shared terrain solids through four
    quarter-turn facings, the follow and manual cutaway camera as pure state and
    commands, the bounded visible faces and the facts that decide their
    exposure, missing-data demand, deterministic back-to-front ordering
    candidates inside the 2D renderer's 24-bit depth keys, and CPU picking
    against the exact plan it was given. It depends on the pure terrain,
    math, render-2d and render-api packages only: no GPU, window, Lua, runtime
    terrain service or game package. Beside that per-face baseline, TRA-16 adds
    the whole-cell quad planner (supplied discovery knowledge and coverage
    assets, exact integer draw keys, bounded progressive demand) and the
    coverage-based visual picker. Every value is immutable and every function
    pure; the package owns no state, thread or resource.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/terrain-render-2d

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Terrain.Render2D.Assets
        Hetoimasia.Terrain.Render2D.AtlasAssets
        Hetoimasia.Terrain.Render2D.Camera
        Hetoimasia.Terrain.Render2D.CellPick
        Hetoimasia.Terrain.Render2D.Cells
        Hetoimasia.Terrain.Render2D.Facts
        Hetoimasia.Terrain.Render2D.Knowledge
        Hetoimasia.Terrain.Render2D.Projection
    -- The exact planar polygon arithmetic and the overlap ordering the public
    -- modules share; a client cannot import them.
    other-modules:
        Hetoimasia.Terrain.Render2D.Internal.Cells
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-atlas ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapbake ==0.1.0.0

-- The offline map bake (TRA-14): the frontmost-facet cutout and unit-normal map
-- of every catalog shape, the complementary mixed-knowledge parts and the
-- rotated lookup, all pure and over the shared canonical solids of
-- hetoimasia-terrain. It reads no file and names no authored path; the
-- generator component and the tests share it.
library terrain-mapbake
    import: language
    visibility: public
    hs-source-dirs: mapbake
    exposed-modules:
        Hetoimasia.Terrain.MapBake.Bake
        Hetoimasia.Terrain.MapBake.Catalog
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        hetoimasia-terrain ==0.1.0.0

-- The terrain atlas contract (TRA-17): the checked, bounded region manifest, the
-- deterministic offline packer and the shared names of the two parent atlases.
-- Pure; it reads no file and has no GPU, Lua, window or game dependency, so the
-- generator, the planner's asset adaptation, the material and the evidence share it.
library terrain-atlas
    import: language
    visibility: public
    hs-source-dirs: atlas
    exposed-modules:
        Hetoimasia.Terrain.Atlas.Manifest
        Hetoimasia.Terrain.Atlas.Pack
    other-modules:
        Hetoimasia.Terrain.Atlas.Internal.Json
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapbake ==0.1.0.0

-- The generator's file side (TRA-14): the pinned inputs and their checks, the
-- PNG and manifest bytes, writing and read-only checking of the committed
-- catalog, the evidence sheets and the command line as a function, shared by
-- the `terrain-mapgen` executable and the tests so that the tool the
-- acceptance runs is the tool that is proved. PNG bytes come only from
-- JuicyPixels over the project's bundled zlib (cabal.project.common), never a
-- host libz or an external image tool.
library terrain-mapgen-core
    import: language
    visibility: public
    hs-source-dirs: mapgen
    exposed-modules:
        Hetoimasia.Terrain.MapGen.Atlas
        Hetoimasia.Terrain.MapGen.Cli
        Hetoimasia.Terrain.MapGen.Evidence
        Hetoimasia.Terrain.MapGen.Generate
        Hetoimasia.Terrain.MapGen.Inputs
        Hetoimasia.Terrain.MapGen.Json
        Hetoimasia.Terrain.MapGen.Png
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3.8 && <1.4,
        filepath >=1.5 && <1.6,
        JuicyPixels ==3.3.9,
        temporary >=1.3 && <1.4,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-atlas ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapbake ==0.1.0.0

-- The offline generator of the cutout and normal-map catalog (TRA-14). It runs
-- from the repository root as `cabal run exe:terrain-mapgen -- --check`, and
-- it is not part of any engine or game library.
executable terrain-mapgen
    import: language
    main-is: Main.hs
    hs-source-dirs: tool
    build-depends:
        base >=4.22 && <4.23,
        hetoimasia-terrain-render-2d:terrain-mapgen-core ==0.1.0.0

-- The terrain material's pure half (TRA-8): the art sheet and style a caller
-- supplies, the record a face carries, the adaptation of a plan's faces into
-- render-2d instances and the model of the material's fragment function. It has
-- no Vulkan, window, Lua or game dependency, so the CPU suite, the Vulkan
-- package's declaration and the device evidence share it.
library terrain-material
    import: language
    visibility: public
    hs-source-dirs: material
    exposed-modules:
        Hetoimasia.Terrain.Render2D.Material
        Hetoimasia.Terrain.Render2D.Presentation
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-render-2d ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapbake ==0.1.0.0

-- Scenes and independent expectations (TRA-8): what the CPU suite and the
-- native evidence scenario both build their fixtures from, through the public
-- terrain and planner interfaces, so neither imports the other's spec. A test
-- support component; no engine library depends on it.
library terrain-fixtures
    import: language
    visibility: public
    hs-source-dirs: fixtures
    exposed-modules:
        Hetoimasia.Terrain.Render2D.Evidence
        Hetoimasia.Terrain.Render2D.Scenes
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-render-2d ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-material ==0.1.0.0

-- This package's own contracts, registered as the CPU validation group
-- `test.terrain-render-2d`. Hspec and QuickCheck are the suite's alone.
test-suite terrain-render-2d-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    -- The pair-bound example reads the runtime's allocation counters, which exist
    -- only when the program is started with -T.
    ghc-options: -rtsopts "-with-rtsopts=-T"
    other-modules:
        Test.TerrainRender2D.Art
        Test.TerrainRender2D.Atlas
        Test.TerrainRender2D.AtlasAssets
        Test.TerrainRender2D.Camera
        Test.TerrainRender2D.CellFixtures
        Test.TerrainRender2D.CellsClient
        Test.TerrainRender2D.Cells
        Test.TerrainRender2D.CellsCoverage
        Test.TerrainRender2D.CellsEvidence
        Test.TerrainRender2D.CellsProgress
        Test.TerrainRender2D.CellsWork
        Test.TerrainRender2D.Fixtures
        Test.TerrainRender2D.MapAssets
        Test.TerrainRender2D.MapAssets.Reference
        Test.TerrainRender2D.Material
        Test.TerrainRender2D.Oracle
        Test.TerrainRender2D.Projection
        Test.TerrainRender2D.Spec
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3.8 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        QuickCheck >=2.15 && <2.19,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-render-2d ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-atlas ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-fixtures ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapbake ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-mapgen-core ==0.1.0.0,
        hetoimasia-terrain-render-2d:terrain-material ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0
