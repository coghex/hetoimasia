cabal-version: 3.16
name: hetoimasia-scripting-lua
version: 0.1.0.0
synopsis: The private Lua binding and foreign-call boundary for Hetoimasia
description:
    One embedded Lua interpreter reached through a private bridge: a VM
    constructed with an explicitly chosen set of standard libraries, chunks
    loaded and run through protected calls, and a terminal close. No exported
    module hands a caller a Lua state, a stack index, a registry reference, a
    coroutine, a closure, or a native address; the raw binding, the callback
    trampoline, and the registry bookkeeping stay in this package's private
    bridge sublibrary. A Lua error is reported as a bounded diagnostic without
    unwinding Haskell. A failure raised by a callback's own action is re-raised
    at the owner's Haskell boundary with its type and context, even if Lua
    catches the message-free light-userdata placeholder. Cancellation targets
    the VM's execution owner and is deferred until the native call and its
    bookkeeping finish; direct cancellation of a callback thread is unsupported
    and can end the process.
    The host library has no runtime, GLFW, Vulkan, console, or game dependency.
    Beside the bridge, and sharing no dependency with it, the package owns the
    pure protocol model: bounded script tasks and their transitions, admission
    and its caps, single-settlement requests, owned subscriptions, session
    epochs, failure, and stop. The protected VM owner is a public module of
    its own: one VM held through a bracket-shaped IO lifetime that closes it on
    every exit and keeps the primary failure and the close's failures as
    cleanup evidence. An application registers named bindings once, in
    namespaces, with schemas for their arguments and results, and gives each
    owner a policy naming the namespaces it exposes; it supplies its own Lua
    modules under a name and version and calls their declared entry points.
    Every value crosses as a bounded copy checked against a schema, and a
    refusal is a typed fault of the call. A public runtime-lua sublibrary, in a
    source directory of its own, puts such owners under runtime supervision:
    each is one supervised worker running its VM on its own thread, ready only
    once its modules have loaded, with bounded non-blocking call submission,
    exactly-once settlement of every accepted call, host failures left to
    supervision, a protected stop that discards queued calls and records them,
    and the refusal of a wait for a reply from inside any Lua callback. The host
    also runs a module's entry point as a Lua coroutine on its VM owner, one
    segment at a time, with yield and wait operations an application registers
    and the standard coroutine library selectable; it schedules nothing. Beside
    the runtime adapter, and needing no VM, is the scheduling machinery for Lua
    tasks: a policy fixed per owner with a FIFO default and a checked extension
    interface, service classes with finite quanta, application-granted logical
    time, elapsed waits behind one owned cancellable timer, service budgets that
    end a turn and never preempt a segment, nonblocking pause, resume and stop
    applied at safe boundaries, and bounded aggregate counters. Scheduled owners
    host that machinery and the host's task coroutines on supervised workers with
    real VMs: tasks are admitted without blocking, each settles exactly once, an
    idle owner blocks in one STM wait, a stop closes every suspended coroutine on
    the owner's thread and keeps closing errors as cleanup evidence, and the same
    logical-time workload runs identically however long its segments take. Script
    instances run on those owners: each is a module's behavior with a fresh state
    of its own, optional init, run and shutdown hooks and functions it connected
    to bounded, ordered event deliveries, one invocation in flight at a time as a
    scheduler task, paused, resumed and stopped by request at safe boundaries,
    ended through one path that revokes its connections, closes its coroutine
    before its shutdown hook and settles it exactly once, with failures isolated
    unless the application escalates one. The confined path is a later slice.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md
extra-source-files:
    bridge/cbits/hetoimasia_lua_bridge.h
    bridge/cbits/hetoimasia_lua_values.h
    hazard/cbits/hetoimasia_lua_probe.h
    linux/cbits/hetoimasia_confine.h
    macos/cbits/hetoimasia_macos_probe.h

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/scripting-lua

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

-- The bridge itself: the VM record and its gate, the selectable standard
-- libraries, the protected call and its bounded error rendering, the temporary
-- registry references, and the Haskell callback trampoline. It is private
-- because every one of those exposes the Lua state, a stack index, or a
-- registry reference; the public library above it exposes none of them.
library bridge
    import: language
    visibility: private
    hs-source-dirs: bridge
    -- Publication has to happen inside a protected Lua call; see the header.
    c-sources:
        bridge/cbits/hetoimasia_lua_bridge.c
        bridge/cbits/hetoimasia_lua_values.c
    include-dirs: bridge/cbits
    install-includes:
        hetoimasia_lua_bridge.h
        hetoimasia_lua_values.h
    exposed-modules:
        Hetoimasia.Scripting.Lua.Internal.Binding
        Hetoimasia.Scripting.Lua.Internal.Boundary
        Hetoimasia.Scripting.Lua.Internal.Call
        Hetoimasia.Scripting.Lua.Internal.Callback
        Hetoimasia.Scripting.Lua.Internal.Fault
        Hetoimasia.Scripting.Lua.Internal.Library
        Hetoimasia.Scripting.Lua.Internal.Marshal
        Hetoimasia.Scripting.Lua.Internal.Module
        Hetoimasia.Scripting.Lua.Internal.Owner
        Hetoimasia.Scripting.Lua.Internal.Registration
        Hetoimasia.Scripting.Lua.Internal.Task
        Hetoimasia.Scripting.Lua.Internal.Value
        Hetoimasia.Scripting.Lua.Internal.Vm
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        lua >=2.3.4 && <2.4,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0

-- The protocol model (LUA-4): bounded script tasks, admission, requests,
-- subscriptions, epochs, session failure, and stop, as pure data and pure
-- transitions. It is a separate component from the bridge rather than a module
-- beside it because the boundary is the point: its `build-depends` names
-- neither `lua` nor `hetoimasia-scripting-lua:bridge`, so the binding cannot
-- reach it and its examples cannot need an interpreter. Checking that boundary
-- is checking this stanza, and `Test.Lua.Protocol.Boundary` checks it here.
--
-- It is private because the types are a contract between this package's own
-- later slices -- the scheduler, the request and subscription
-- protocol, and the child-process transport -- not a public API. Nothing
-- outside the package depends on it yet.
library model
    import: language
    visibility: private
    hs-source-dirs: model
    exposed-modules:
        Hetoimasia.Scripting.Lua.Internal.Protocol.Failure
        Hetoimasia.Scripting.Lua.Internal.Protocol.Identity
        Hetoimasia.Scripting.Lua.Internal.Protocol.Limits
        Hetoimasia.Scripting.Lua.Internal.Protocol.Request
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Epoch
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Failure
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Requests
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Revocation
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.State
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Step
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Stop
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Subscriptions
        Hetoimasia.Scripting.Lua.Internal.Protocol.Session.Tasks
        Hetoimasia.Scripting.Lua.Internal.Protocol.Subscription
        Hetoimasia.Scripting.Lua.Internal.Protocol.Task
        Hetoimasia.Scripting.Lua.Internal.Protocol.Value
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        text >=2.1 && <2.2

-- What a client outside this package may say: construct a VM over a chosen set
-- of libraries, load and run a chunk, call a global the VM already defines, and
-- close it; or, through the protected owner, run a body over a VM that the
-- lifetime closes on every exit. Nothing here mentions the binding's types.
library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Scripting.Lua.Bridge
        Hetoimasia.Scripting.Lua.Owner
        Hetoimasia.Scripting.Lua.Registration
        Hetoimasia.Scripting.Lua.Value
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-scripting-lua:bridge

-- The runtime adapter (LUA-5): trusted VM owners under runtime supervision. One
-- owner is one supervised worker running one VM through `withVmOwner` on its own
-- thread, with bounded call dispatch, exactly-once settlement and the refusal of
-- a reply wait from inside any Lua callback.
--
-- It lives in a sublibrary of its own, in a separate source directory, because
-- the host library above must not depend on the runtime (P-1): it depends on the
-- host, on the runtime's supervision and on the foundation, and the host
-- depends on none of them. It depends on nothing of GLFW, Vulkan, the console
-- or any game. The private `model` supplies the caps' validation, and the
-- private `bridge` is named only where it must be: the process-wide record of
-- the threads running a Lua callback, the mark a failure of application code
-- carries, and the value limits' check, none of which the host's public modules
-- offer an application. `Test.LuaRuntime.Dependencies` checks this stanza and
-- the imports of its modules.
library runtime-lua
    import: language
    -- Named sublibraries are private unless they say otherwise, and an application
    -- in another package is who this one is for.
    visibility: public
    hs-source-dirs: runtime-lua
    exposed-modules:
        Hetoimasia.Scripting.Lua.Lease
        Hetoimasia.Scripting.Lua.Lending
        Hetoimasia.Scripting.Lua.Provider
        Hetoimasia.Scripting.Lua.Request
        Hetoimasia.Scripting.Lua.Runtime
        Hetoimasia.Scripting.Lua.Instance
        Hetoimasia.Scripting.Lua.Lifecycle
        Hetoimasia.Scripting.Lua.Scheduled
        Hetoimasia.Scripting.Lua.Scheduler
    other-modules:
        Hetoimasia.Scripting.Lua.Instance.Driver
        Hetoimasia.Scripting.Lua.Instance.Run
        Hetoimasia.Scripting.Lua.Instance.State
        Hetoimasia.Scripting.Lua.Instance.Types
        Hetoimasia.Scripting.Lua.Lease.State
        Hetoimasia.Scripting.Lua.Retention
        Hetoimasia.Scripting.Lua.Lending.Loan
        Hetoimasia.Scripting.Lua.Lifecycle.State
        Hetoimasia.Scripting.Lua.Provider.Events
        Hetoimasia.Scripting.Lua.Provider.Serve
        Hetoimasia.Scripting.Lua.Provider.State
        Hetoimasia.Scripting.Lua.Provider.Subscribe
        Hetoimasia.Scripting.Lua.Provider.Types
        Hetoimasia.Scripting.Lua.Runtime.Admission
        Hetoimasia.Scripting.Lua.Runtime.Dispatch
        Hetoimasia.Scripting.Lua.Runtime.Shared
        Hetoimasia.Scripting.Lua.Runtime.Types
        Hetoimasia.Scripting.Lua.Scheduled.Run
        Hetoimasia.Scripting.Lua.Scheduled.Shared
        Hetoimasia.Scripting.Lua.Scheduled.Types
        Hetoimasia.Scripting.Lua.Scheduler.Policy
        Hetoimasia.Scripting.Lua.Scheduler.State
        Hetoimasia.Scripting.Lua.Scheduler.Timer
        Hetoimasia.Scripting.Lua.Scheduler.Types
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        deepseq >=1.5.1 && <1.6,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge,
        hetoimasia-scripting-lua:model

-- The hazard runner. An example that cannot be bounded inside the suite's own
-- process -- cancelling a thread that is inside Lua does not interrupt Lua, so
-- the thread never dies -- runs here instead, reports what it observed on
-- stdout, and is terminated by the suite, which keeps the exit status as the
-- example's evidence. It is a test fixture, not a shipped tool.
executable lua-hazard
    import: language
    hs-source-dirs: hazard
    main-is: Main.hs
    -- Lua's own count hook, which is the only vantage point inside a pure-Lua
    -- interval; see the header for why the question needs one.
    c-sources: hazard/cbits/hetoimasia_lua_probe.c
    include-dirs: hazard/cbits bridge/cbits
    includes: hetoimasia_lua_probe.h
    -- -N2 rather than -N: the hazard needs one capability for the thread that
    -- is inside Lua and one for the thread that observes it, on every machine
    -- that runs it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        lua >=2.3.4 && <2.4,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge

