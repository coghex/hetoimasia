-- The macOS confinement probe's shared side, private to this package and built
-- only on Darwin. It is LUA-15's feasibility evidence, not an engine facility:
-- nothing in the library, the console executable, or any public API depends on
-- it, and it exposes no way to admit untrusted source. On every other platform
-- the component is not built, rather than built and passing vacuously.
--
-- Both of the mechanisms it measures are resolved at run time rather than
-- linked, because whether they are exported at all is one of the questions.
-- See docs/macos_confinement_verdict.md for what they turned out to be worth.
library macos-probe
    import: language
    visibility: private
    hs-source-dirs: macos/lib
    c-sources: macos/cbits/hetoimasia_macos_probe.c
    include-dirs: macos/cbits
    exposed-modules:
        Hetoimasia.Scripting.Lua.Internal.MacOS.Confine
        Hetoimasia.Scripting.Lua.Internal.MacOS.Launch
        Hetoimasia.Scripting.Lua.Internal.MacOS.Report
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5 && <2.6,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9
    if os(darwin)
        buildable: True
    else
        buildable: False

-- The confined helper itself. The parent spawns this image directly: a
-- spawn-time memory limit does not survive an exec, so an exec-based wrapper
-- would quietly drop the only whole-process limit this platform offers.
executable macos-confinement-helper
    import: language
    hs-source-dirs: macos/helper
    main-is: Main.hs
    -- -N2 rather than -N: the helper has to be a threaded-RTS child with more
    -- than one capability, because that is the configuration LUA-1 selected and
    -- the one whose virtual reservation the memory row is about.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:macos-probe
    if os(darwin)
        buildable: True
    else
        buildable: False

-- LUA-15's proof matrix, driven from the trusted parent side. Optional and
-- local-only: it is registered in tools/validation/catalog.json as an optional
-- cpu group, Linux CI never selects it, and its receipt records Darwin.
test-suite macos-confinement-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: macos/test
    other-modules:
        Test.MacOS.Confinement
        Test.MacOS.Driver
        Test.MacOS.Isolation
        Test.MacOS.Lifetime
        Test.MacOS.Limits
        Test.MacOS.Spec
    -- -N2 rather than -N: the two-instance example needs the parent to watch
    -- one helper while another is running, on every machine that runs it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-tool-depends: hetoimasia-scripting-lua:macos-confinement-helper
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-test-support ==0.1.0.0,
        hetoimasia-scripting-lua:macos-probe
    if os(darwin)
        buildable: True
    else
        buildable: False

-- The Linux feasibility probe's child (LUA-14). A private platform component:
-- it is built only on Linux, nothing links it, and the only Lua source it ever
-- loads is the fixture chunk compiled into it. On any other platform the
-- component is not built at all rather than built and passing vacuously.
--
-- `-xr256m` is the memory experiment's prerequisite rather than a tuning knob.
-- The runtime's two-step allocator reserves a terabyte of address space by
-- default, and the ceiling the experiment installs is an address-space ceiling:
-- with the default reservation the child would exhaust it before `main` ran and
-- the experiment would be measuring startup. `-N2` is the threaded
-- configuration LUA-1 selected, and it is what makes the filter's
-- whole-process claim a claim about more than one thread.
executable lua-confine-child
    import: language
    hs-source-dirs: linux/child
    main-is: Main.hs
    c-sources: linux/cbits/hetoimasia_confine.c
    include-dirs: linux/cbits
    includes: hetoimasia_confine.h
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -xr256m"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge
    if os(linux)
        buildable: True
    else
        buildable: False

-- The probe's parent side, and the verdict's evidence. It launches confined
-- children, reads what they observed, ends them, and records the machine it
-- ran on; it draws no conclusion about whether the profile is adequate, which
-- is docs/lua_linux_confinement_verdict.md's.
test-suite linux-confinement-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: linux/test
    other-modules:
        Test.Confinement.Isolation
        Test.Confinement.Lifetime
        Test.Confinement.Limits
        Test.Confinement.Profile
        Test.Confinement.Spec
        Test.Confinement.Support
    c-sources: linux/cbits/hetoimasia_confine.c
    include-dirs: linux/cbits
    includes: hetoimasia_confine.h
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-tool-depends: hetoimasia-scripting-lua:lua-confine-child
    build-depends:
        base >=4.22 && <4.23,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        temporary >=1.3 && <1.4,
        unix >=2.8 && <2.9,
        hetoimasia-test-support ==0.1.0.0
    if os(linux)
        buildable: True
    else
        buildable: False
