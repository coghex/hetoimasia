cabal-version: 3.16
name: hetoimasia-scripting-lua
version: 0.1.0.0
synopsis: The private Lua binding and foreign-call boundary for Hetoimasia
description:
    One embedded Lua interpreter reached through a private bridge: a VM
    constructed with an explicitly chosen set of standard libraries, chunks
    loaded and run through protected calls, and a terminal close. No exported
    module hands a caller a Lua state, a stack index, a registry reference, a
    coroutine, a closure, or a native address; the raw binding, the callback
    trampoline, and the registry bookkeeping stay in this package's private
    bridge sublibrary. A Lua error is reported as a bounded diagnostic without
    unwinding Haskell, and a Haskell exception or a cancellation that reaches
    a callback is re-raised at the Haskell boundary with its type and context
    rather than becoming an ordinary Lua error that @pcall@ can swallow.
    This library has no runtime, GLFW, Vulkan, console, or game dependency.
    The public module and capability registration surface, the protected VM
    owner, and the task model are later slices.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md
extra-source-files:
    bridge/cbits/hetoimasia_lua_bridge.h
    hazard/cbits/hetoimasia_lua_probe.h
    linux/cbits/hetoimasia_confine.h
    macos/cbits/hetoimasia_macos_probe.h

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/scripting-lua

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

-- The bridge itself: the VM record and its gate, the selectable standard
-- libraries, the protected call and its bounded error rendering, the temporary
-- registry references, and the Haskell callback trampoline. It is private
-- because every one of those exposes the Lua state, a stack index, or a
-- registry reference; the public library above it exposes none of them.
library bridge
    import: language
    visibility: private
    hs-source-dirs: bridge
    -- Publication has to happen inside a protected Lua call; see the header.
    c-sources: bridge/cbits/hetoimasia_lua_bridge.c
    include-dirs: bridge/cbits
    install-includes: hetoimasia_lua_bridge.h
    exposed-modules:
        Hetoimasia.Scripting.Lua.Internal.Call
        Hetoimasia.Scripting.Lua.Internal.Callback
        Hetoimasia.Scripting.Lua.Internal.Fault
        Hetoimasia.Scripting.Lua.Internal.Library
        Hetoimasia.Scripting.Lua.Internal.Vm
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        lua >=2.3.4 && <2.4,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0

-- What a client outside this package may say: construct a VM over a chosen set
-- of libraries, load and run a chunk, call a global the VM already defines, and
-- close it. Nothing here mentions the binding's types.
library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Scripting.Lua.Bridge
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-scripting-lua:bridge

-- The hazard runner. An example that cannot be bounded inside the suite's own
-- process -- cancelling a thread that is inside Lua does not interrupt Lua, so
-- the thread never dies -- runs here instead, reports what it observed on
-- stdout, and is terminated by the suite, which keeps the exit status as the
-- example's evidence. It is a test fixture, not a shipped tool.
executable lua-hazard
    import: language
    hs-source-dirs: hazard
    main-is: Main.hs
    -- Lua's own count hook, which is the only vantage point inside a pure-Lua
    -- interval; see the header for why the question needs one.
    c-sources: hazard/cbits/hetoimasia_lua_probe.c
    include-dirs: hazard/cbits bridge/cbits
    includes: hetoimasia_lua_probe.h
    -- -N2 rather than -N: the hazard needs one capability for the thread that
    -- is inside Lua and one for the thread that observes it, on every machine
    -- that runs it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        lua >=2.3.4 && <2.4,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge

-- The bridge's own contracts: the fault and cancellation transport, stack and
-- registry discipline, the terminal close, independent execution, and the
-- selectable libraries, plus the export boundary the package promises.
test-suite lua-host-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.Lua.Close
        Test.Lua.Discipline
        Test.Lua.Faults
        Test.Lua.Hazard
        Test.Lua.Independence
        Test.Lua.Libraries
        Test.Lua.Opacity
        Test.Lua.Spec
        Test.Lua.Support
    -- -N2 rather than -N: the independent-progress example needs Haskell to
    -- run while a capability is inside a substantial Lua computation, on every
    -- machine that runs it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-tool-depends: hetoimasia-scripting-lua:lua-hazard
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        lua >=2.3.4 && <2.4,
        process >=1.6 && <1.7,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge

-- The macOS confinement probe's shared side, private to this package and built
-- only on Darwin. It is LUA-15's feasibility evidence, not an engine facility:
-- nothing in the library, the console executable, or any public API depends on
-- it, and it exposes no way to admit untrusted source. On every other platform
-- the component is not built, rather than built and passing vacuously.
--
-- Both of the mechanisms it measures are resolved at run time rather than
-- linked, because whether they are exported at all is one of the questions.
-- See docs/macos_confinement_verdict.md for what they turned out to be worth.
library macos-probe
    import: language
    visibility: private
    hs-source-dirs: macos/lib
    c-sources: macos/cbits/hetoimasia_macos_probe.c
    include-dirs: macos/cbits
    exposed-modules:
        Hetoimasia.Scripting.Lua.Internal.MacOS.Confine
        Hetoimasia.Scripting.Lua.Internal.MacOS.Launch
        Hetoimasia.Scripting.Lua.Internal.MacOS.Report
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5 && <2.6,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9
    if os(darwin)
        buildable: True
    else
        buildable: False

-- The confined helper itself. The parent spawns this image directly: a
-- spawn-time memory limit does not survive an exec, so an exec-based wrapper
-- would quietly drop the only whole-process limit this platform offers.
executable macos-confinement-helper
    import: language
    hs-source-dirs: macos/helper
    main-is: Main.hs
    -- -N2 rather than -N: the helper has to be a threaded-RTS child with more
    -- than one capability, because that is the configuration LUA-1 selected and
    -- the one whose virtual reservation the memory row is about.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:macos-probe
    if os(darwin)
        buildable: True
    else
        buildable: False

-- LUA-15's proof matrix, driven from the trusted parent side. Optional and
-- local-only: it is registered in tools/validation/catalog.json as an optional
-- cpu group, Linux CI never selects it, and its receipt records Darwin.
test-suite macos-confinement-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: macos/test
    other-modules:
        Test.MacOS.Confinement
        Test.MacOS.Driver
        Test.MacOS.Isolation
        Test.MacOS.Lifetime
        Test.MacOS.Limits
        Test.MacOS.Spec
    -- -N2 rather than -N: the two-instance example needs the parent to watch
    -- one helper while another is running, on every machine that runs it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-tool-depends: hetoimasia-scripting-lua:macos-confinement-helper
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-test-support ==0.1.0.0,
        hetoimasia-scripting-lua:macos-probe
    if os(darwin)
        buildable: True
    else
        buildable: False

-- The Linux feasibility probe's child (LUA-14). A private platform component:
-- it is built only on Linux, nothing links it, and the only Lua source it ever
-- loads is the fixture chunk compiled into it. On any other platform the
-- component is not built at all rather than built and passing vacuously.
--
-- `-xr256m` is the memory experiment's prerequisite rather than a tuning knob.
-- The runtime's two-step allocator reserves a terabyte of address space by
-- default, and the ceiling the experiment installs is an address-space ceiling:
-- with the default reservation the child would exhaust it before `main` ran and
-- the experiment would be measuring startup. `-N2` is the threaded
-- configuration LUA-1 selected, and it is what makes the filter's
-- whole-process claim a claim about more than one thread.
executable lua-confine-child
    import: language
    hs-source-dirs: linux/child
    main-is: Main.hs
    c-sources: linux/cbits/hetoimasia_confine.c
    include-dirs: linux/cbits
    includes: hetoimasia_confine.h
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -xr256m"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:bridge
    if os(linux)
        buildable: True
    else
        buildable: False

-- The probe's parent side, and the verdict's evidence. It launches confined
-- children, reads what they observed, ends them, and records the machine it
-- ran on; it draws no conclusion about whether the profile is adequate, which
-- is docs/lua_linux_confinement_verdict.md's.
test-suite linux-confinement-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: linux/test
    other-modules:
        Test.Confinement.Isolation
        Test.Confinement.Lifetime
        Test.Confinement.Limits
        Test.Confinement.Profile
        Test.Confinement.Spec
        Test.Confinement.Support
    c-sources: linux/cbits/hetoimasia_confine.c
    include-dirs: linux/cbits
    includes: hetoimasia_confine.h
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2"
    build-tool-depends: hetoimasia-scripting-lua:lua-confine-child
    build-depends:
        base >=4.22 && <4.23,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        temporary >=1.3 && <1.4,
        unix >=2.8 && <2.9,
        hetoimasia-test-support ==0.1.0.0
    if os(linux)
        buildable: True
    else
        buildable: False
