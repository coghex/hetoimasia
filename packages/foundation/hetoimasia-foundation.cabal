cabal-version: 3.16
name: hetoimasia-foundation
version: 0.1.0.0
synopsis: Small independent services for Hetoimasia
description:
    A structured logging interface with validated components, pure filter
    configuration, scoped context, and explicit sink ownership; failure-preserving
    CPU resource scopes, and a scoped collection of independent resources owned
    by one thread and retired early in any order; and origin and operation
    context for engine failures, retained on the exception; bounded, classified recovery around one
    complete owned operation; and scoped component construction that selects
    among rolled-back alternatives under the same policy; and owned CPU worker
    threads with scoped startup, cooperative stop, cancellation, terminal
    observation, and a protected drain before borrowed dependencies unwind;
    and immutable message payloads fully evaluated through NFData on the
    producer's thread before publication, carried by bounded FIFO channels with
    separate send, receive, and owner-control endpoints, a terminal state, and
    atomic counters, and by latest-value snapshots read through checked cursors;
    and a monotonic time boundary: an injected monotonic clock, opaque
    non-negative instants and durations with validated construction, and
    non-wrapping deadline arithmetic and elapsed sampling.
    This library has no application state, graphics, scripting, or game
    dependencies.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/foundation

library
    exposed-modules:
        Hetoimasia.Foundation.Failure
        Hetoimasia.Foundation.Log
        Hetoimasia.Foundation.Messaging.Channel
        Hetoimasia.Foundation.Messaging.Payload
        Hetoimasia.Foundation.Messaging.Snapshot
        Hetoimasia.Foundation.Recovery
        Hetoimasia.Foundation.Resource
        Hetoimasia.Foundation.Resource.Collection
        Hetoimasia.Foundation.Time
        Hetoimasia.Foundation.Worker
    -- Hidden modules of this library: the public Log, Failure, Recovery and
    -- Resource.Collection modules re-export what clients may use from them,
    -- and a client importing one directly is refused. Unlike the internal sublibrary below, which other
    -- components of this package share, these serve this library alone.
    --   Log.Base: levels, source locations and small options, below every other
    --     logging module and imported by failure attribution.
    --   Log.Component: the validated Component, private so its constructor
    --     stays unexported, with the quoting its diagnostics share.
    --   Log.Types: the filter, entry, sink, metadata and logger records,
    --     private so the LogSink and Logger constructors stay unexported.
    --   Log.Filter: configuration parsing, and the admission predicate the
    --     facade does not export.
    --   Log.Format: the record layout and escaping behind formatEntry.
    --   Log.Sink: sink construction and serialized writes behind the facade.
    --   Failure.Base: Operation, private so its constructor stays unexported.
    --   Failure.Types: the evidence records and the failure annotation, private
    --     so the annotation stays unexported and only the facade attaches it.
    --   Recovery.Types: the policy, outcome and history types, and the history
    --     annotation with its rendering, private so the annotation stays
    --     unexported and only the two recovery boundaries attach it. It imports
    --     Failure.Base for Operation, never Failure or Recovery.
    --   Resource.Collection.Types: the collection, member state and token, and
    --     the result and rejection types, private so Collection and Member keep
    --     their constructors unexported; Resource.Collection re-exports them.
    other-modules:
        Hetoimasia.Foundation.Failure.Base
        Hetoimasia.Foundation.Failure.Types
        Hetoimasia.Foundation.Log.Base
        Hetoimasia.Foundation.Log.Component
        Hetoimasia.Foundation.Log.Filter
        Hetoimasia.Foundation.Log.Format
        Hetoimasia.Foundation.Log.Sink
        Hetoimasia.Foundation.Log.Types
        Hetoimasia.Foundation.Recovery.Types
        Hetoimasia.Foundation.Resource.Collection.Types
    hs-source-dirs: src
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        deepseq >=1.5.1 && <1.6,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        time >=1.15 && <1.16,
        hetoimasia-foundation:internal

-- The implementations behind the public resource and worker modules, shared
-- inside this package and nowhere else. It holds the Scoped representation and
-- the composite ledger, which the resource API and the scoped constructors of
-- other foundation modules build on without exposing either constructor to
-- clients, and the worker group, whose public module re-exports everything but
-- the coordination probe the foundation's own tests hold helpers with. Being
-- private, it is visible to this package's components and to no client.
--
-- Only the two facades are exposed, so the rest of the package reaches the
-- modules below through Resource.Internal and Worker.Internal alone. Those
-- hidden modules import one another directly, never either facade, and nothing
-- from the main library; the worker modules import Resource.Scoped and
-- Resource.Cleanup directly. The resource modules:
--   Resource.Cleanup: the single owner of cleanup identity and evidence; the
--     CleanupFailureId and CleanupFailure representations, the counter that
--     issues identities, inspection, and the release and retention primitives.
--     Private so no client can build or rewrite an evidence entry.
--   Resource.Types: release ranks and the assembly representation (Part,
--     Assembling, Assembly, Ledger), private so no client can run an assembly
--     or reach a ledger.
--   Resource.Assembly: staged acquisition, rollback and lending over those
--     types, private because each operation trusts its caller to keep the
--     mask discipline.
--   Resource.Scoped: the Scoped continuation type and its runner, private so
--     no client can build or rewrite a scope.
-- The worker modules, in dependency order; Worker.Startup and Worker.Group
-- import every module above them and never each other:
--   Worker.Base: worker identity, the request record, the stop token, the
--     cancellation exception and the group phase, private so WorkerId and
--     StopToken keep their constructors unexported.
--   Worker.Outcome: run exits, results, completions, the startup and group
--     reports, and the helpers that classify a caught failure, private
--     because those helpers are not part of the contract.
--   Worker.Types: the group, entry, closing snapshot, drain-status records,
--     coordination probe, handle and definition, private so WorkerGroup,
--     Worker and WorkerDefinition keep their constructors and fields
--     unexported and no client can name an entry.
--   Worker.Evidence: the evidence attached to a propagated failure and its
--     readers, private so only this implementation attaches it.
--   Worker.Observation: the drain status, startup and completion reads, the
--     committed observation and settled retirement, private because
--     retirement writes group state.
--   Worker.Requests: stop and cancellation requests, the cancellation helper
--     and a failing starter's drain, private because they act on entries.
--   Worker.Startup: registration, the fork and handoff, the child thread and
--     terminal publication, private because they write group state.
--   Worker.Group: the lifetime boundary, closing, the report and the
--     protected drain, private because they write group state and install the
--     coordination probe.
library internal
    visibility: private
    exposed-modules:
        Hetoimasia.Foundation.Resource.Internal
        Hetoimasia.Foundation.Worker.Internal
    other-modules:
        Hetoimasia.Foundation.Resource.Assembly
        Hetoimasia.Foundation.Resource.Cleanup
        Hetoimasia.Foundation.Resource.Scoped
        Hetoimasia.Foundation.Resource.Types
        Hetoimasia.Foundation.Worker.Base
        Hetoimasia.Foundation.Worker.Evidence
        Hetoimasia.Foundation.Worker.Group
        Hetoimasia.Foundation.Worker.Observation
        Hetoimasia.Foundation.Worker.Outcome
        Hetoimasia.Foundation.Worker.Requests
        Hetoimasia.Foundation.Worker.Startup
        Hetoimasia.Foundation.Worker.Types
    hs-source-dirs: internal
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2

-- The foundation's own contracts. It depends on this package, the neutral
-- test-support library, and third-party packages alone, so it builds without
-- the runtime, GLFW, or the console.
test-suite foundation-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.Foundation.Spec
        Test.Foundation.Failures.Spec
        Test.Foundation.Logging.Component
        Test.Foundation.Logging.Configuration
        Test.Foundation.Logging.Context
        Test.Foundation.Logging.Filtering
        Test.Foundation.Logging.Layout
        Test.Foundation.Logging.Opacity
        Test.Foundation.Logging.Sink
        Test.Foundation.Logging.Spec
        Test.Foundation.Logging.Support
        Test.Foundation.Logging.Worker
        Test.Foundation.Messaging.Channel
        Test.Foundation.Messaging.Opacity
        Test.Foundation.Messaging.Snapshot
        Test.Foundation.Messaging.Spec
        Test.Foundation.Messaging.Support
        Test.Foundation.Messaging.Turns
        Test.Foundation.Recovery.Spec
        Test.Foundation.Recovery.Visibility
        Test.Foundation.Resources.Buffer
        Test.Foundation.Resources.Collection
        Test.Foundation.Resources.Construction
        Test.Foundation.Resources.Cost
        Test.Foundation.Resources.Journal
        Test.Foundation.Resources.Opacity
        Test.Foundation.Resources.Spec
        Test.Foundation.Resources.Visibility
        Test.Foundation.Time.Opacity
        Test.Foundation.Time.Spec
        Test.Foundation.Workers.Opacity
        Test.Foundation.Workers.Spec
        Test.Foundation.Workers.Visibility
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    -- -T keeps the runtime's allocation statistics available, which the
    -- cleanup-evidence inspection cost examples read.
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -threaded -rtsopts -with-rtsopts=-T
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        deepseq >=1.5.1 && <1.6,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        time >=1.15 && <1.16,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-foundation:internal,
        hetoimasia-test-support ==0.1.0.0
