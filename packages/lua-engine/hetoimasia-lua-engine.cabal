cabal-version: 3.16
name: hetoimasia-lua-engine
version: 0.1.0.0
synopsis: The Lua-first engine's manifest, fixed M1 profile, behavior selection and boot checkpoint
description:
    The Lua-first engine's configuration boundary and role policy. The manifest
    and profile (LFE-3) are pure: a strict, bounded parser for the format-1
    launch manifest @hetoimasia.json@, from caller-supplied bytes to a resolved
    role, entry and tick configuration, and the fixed M1 profile of limits with
    validated, smaller test profiles. The behavior selection (LFE-8) is the M1
    policy over the Lua runtime's generic behavior mechanism: which export field
    each role selects, the cadence rules and their exact conversions, and the
    export-module ceilings the profile gives a VM. The boot checkpoint (LFE-6)
    composes the parser with the generic content inventory before any authored
    Lua: the manifest bytes parsed are the bytes the scan pinned, and every
    declared entry names an inventoried regular file; it reads only through the
    verified read the caller passes in. None of it starts Lua, a worker, a
    window or a GPU. It depends on the foundation's time values, the content
    package and the Lua host and its runtime's public modules, and on no GLFW,
    Vulkan, console, sample or game package.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/lua-engine

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.LuaEngine.Behavior
        Hetoimasia.LuaEngine.Boot
        Hetoimasia.LuaEngine.Manifest
        Hetoimasia.LuaEngine.Profile
    -- The manifest's syntax, schema, tick and result types, and the profile's
    -- limits, fixed values and validation, behind the two facades.
    other-modules:
        Hetoimasia.LuaEngine.Manifest.Error
        Hetoimasia.LuaEngine.Manifest.Json
        Hetoimasia.LuaEngine.Manifest.Schema
        Hetoimasia.LuaEngine.Manifest.Tick
        Hetoimasia.LuaEngine.Manifest.Types
        Hetoimasia.LuaEngine.Profile.Fixed
        Hetoimasia.LuaEngine.Profile.Limits
        Hetoimasia.LuaEngine.Profile.Validate
    build-depends:
        base >=4.22 && <4.23,
        array >=0.5 && <0.6,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-scripting-lua,
        hetoimasia-scripting-lua:runtime-lua,
        text >=2.1 && <2.2

-- The M1 request adapter (LFE-7): the profile's request policy and the exact common result
-- schema, over the host's opt-in admission. It lives in a sublibrary of its own, in a source
-- directory of its own, because the library above is the pure configuration boundary and must
-- stay one: it imports nothing that performs IO, and this does. It depends on the library for the
-- profile, on the host and on the host's runtime adapter for the admission it adapts. It
-- imports no module of a game, a window, a GPU, the console or the content layer.
library request
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: request
    exposed-modules:
        Hetoimasia.LuaEngine.Request
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The M1 raw-data provider (LFE-10): the endpoint that answers a request for a file's exact bytes
-- through the content package's read pool, and the per-VM byte bank that bounds what it retains. It
-- is a sublibrary of its own, in a source directory of its own, for the reason the request adapter
-- is: the library is the pure configuration boundary and imports nothing that performs IO, and this
-- does. It depends on the request adapter for the policy, on the content package for the pool and
-- the inventory, and on the host's public runtime modules for the provider surface. It imports no
-- module of a game, a window, a GPU or the console, and installs nothing in a VM.
library data
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: data
    exposed-modules:
        Hetoimasia.LuaEngine.Data
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:request,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The M1 module-job coordinator (LFE-11): one VM-owned load job for each module, the waiters that
-- join it and receive its outcome at their own assigned positions, and the source stage that feeds
-- it from the session's pool of verified reads. It is a sublibrary of its own, in a source directory
-- of its own, for the reason the request adapter is: the library is the pure configuration boundary
-- and imports nothing that performs IO, and this does. It depends on the request adapter for the
-- policy, on the content package for the inventory and the pool, and on the host's public runtime
-- modules for the loader and the provider surface. It imports no module of a game, a window, a GPU or
-- the console, and installs nothing in a VM.
library modules
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: modules
    exposed-modules:
        Hetoimasia.LuaEngine.Modules
    other-modules:
        Hetoimasia.LuaEngine.Modules.Address
        Hetoimasia.LuaEngine.Modules.Bank
        Hetoimasia.LuaEngine.Modules.Failure
        Hetoimasia.LuaEngine.Modules.State
        Hetoimasia.LuaEngine.Modules.Types
        Hetoimasia.LuaEngine.Modules.Wiring
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:request,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The M1 authoring facade (LFE-12): what an instance's hooks are handed (the content, request and time
-- services bound to the instance), the lexical-root import's resolver, and bounded print and warn. It
-- is a sublibrary of its own, in a source directory of its own, for the reason the request adapter is:
-- the library is the pure configuration boundary and imports nothing that performs IO, and this does.
-- It depends on the request adapter, the data provider and the module coordinator for the services it
-- binds, on the content package for the address policy and on the host's public modules for the
-- bindings it installs. It imports no module of a game, a window, a GPU, Vulkan, GLFW or the console,
-- no texture or scene module, and installs nothing until an assembly asks it to.
library facade
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: facade
    exposed-modules:
        Hetoimasia.LuaEngine.Facade
    -- The bindings, the Lua the engine runs before authored code and the resolver, behind the facade.
    other-modules:
        Hetoimasia.LuaEngine.Facade.Bindings
        Hetoimasia.LuaEngine.Facade.Caller
        Hetoimasia.LuaEngine.Facade.Content
        Hetoimasia.LuaEngine.Facade.Output
        Hetoimasia.LuaEngine.Facade.Request
        Hetoimasia.LuaEngine.Facade.Source
        Hetoimasia.LuaEngine.Facade.Time
        Hetoimasia.LuaEngine.Facade.Types
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:data,
        hetoimasia-lua-engine:modules,
        hetoimasia-lua-engine:request,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The M1 texture pipeline (LFE-16): the endpoint that answers a request for a usable, instance-owned
-- texture, the two lanes, the one decode worker and the reservations behind it, and the port the
-- concrete graphics adapter (LFE-17) implements. It is a sublibrary of its own, in a source directory
-- of its own, for the reason the data provider is: the library is the pure configuration boundary and
-- imports nothing that performs IO, and this does. It depends on the request adapter for the policy, on
-- the content package for the shared read pool, on the bounded PNG decoder for the decode, and on the
-- host's public runtime modules for the provider and lease surface. It imports no module of a game, a
-- window, a GPU, Vulkan, GLFW or the console, and installs nothing in a VM.
library texture
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: texture
    exposed-modules:
        Hetoimasia.LuaEngine.Texture
        Hetoimasia.LuaEngine.Texture.Backend
    -- The per-texture banks and the pipeline's state machine, behind the facade.
    other-modules:
        Hetoimasia.LuaEngine.Texture.Banks
        Hetoimasia.LuaEngine.Texture.Pipeline
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:request,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The M1 scene schema (LFE-19): the plain-table scene a script hands over, checked and copied into
-- bounded immutable CPU data, its sRGB and Float32 conversions, and the translation to the renderer's
-- pure snapshot. It is a sublibrary of its own, in a source directory of its own, for the reason the
-- texture pipeline is: the library is the pure configuration boundary and imports nothing that
-- performs IO, and this borrows textures from an instance's leases. It depends on the profile for the
-- limits, on the texture sublibrary for the instance's texture authority, on the host's public
-- modules and runtime adapter for the values, bindings and leases, and on the pure renderer packages
-- for the frame. It imports no module of a game, a window, a GPU, Vulkan, GLFW, the console or the
-- oracle (which is a test dependency), and installs nothing in a VM.
library scene
    import: language
    visibility: public
    default-extensions: OverloadedStrings
    hs-source-dirs: scene
    exposed-modules:
        Hetoimasia.LuaEngine.Scene
    -- The limits, the types, the conversions and the translation, behind the facade.
    other-modules:
        Hetoimasia.LuaEngine.Scene.Binding
        Hetoimasia.LuaEngine.Scene.Colour
        Hetoimasia.LuaEngine.Scene.Geometry
        Hetoimasia.LuaEngine.Scene.Limits
        Hetoimasia.LuaEngine.Scene.Prepare
        Hetoimasia.LuaEngine.Scene.Snapshot
        Hetoimasia.LuaEngine.Scene.Types
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        text >=2.1 && <2.2,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:texture,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

