cabal-version: 3.16
name: hetoimasia-lua-engine-graphics
version: 0.1.0.0
synopsis: The graphics adapter of the Lua-first engine's texture requests
description:
    The concrete backend of the Lua-first engine's texture pipeline (LFE-17): allocates, uploads
    and registers each decoded texture on the protected graphics owner the host lends, and
    answers the pipeline's port only when the upload has been observed complete and the
    registration observed to resolve to its own slot of a bound table. It works before any window
    exists, maps the fixed M1 profile's native budgets onto the native backend's validated
    configuration, and retires a texture only on the table's own evidence. It depends on the
    pipeline's CPU port, the native backend, the window integration's public host and the 2D
    renderer's Vulkan recorder; the CPU Lua-engine, content and codec packages depend on none of
    it. It is selected only by `cabal.project.vulkan`.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/lua-engine-graphics

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.LuaEngine.Graphics.Texture
        Hetoimasia.LuaEngine.Graphics.Texture.Backend
        Hetoimasia.LuaEngine.Graphics.Texture.Configuration
        Hetoimasia.LuaEngine.Graphics.Texture.Host
        Hetoimasia.LuaEngine.Graphics.Texture.Port
        Hetoimasia.LuaEngine.Graphics.Window.Configuration
        Hetoimasia.LuaEngine.Graphics.Window.Host
        Hetoimasia.LuaEngine.Graphics.Window.Port
        Hetoimasia.LuaEngine.Graphics.Window.Provider
        Hetoimasia.LuaEngine.Graphics.Window.Request
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw ==0.1.0.0,
        hetoimasia-glfw:runtime-glfw ==0.1.0.0,
        hetoimasia-gpu-vulkan-glfw ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine:request,
        hetoimasia-lua-engine:texture,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-render-2d-vulkan ==0.1.0.0,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The adapter's lifecycle contracts over an injected owner and completion boundary, registered with the
-- group `test.vulkan-headless`. They need no device, display or GLFW session: the backend runs over a
-- port whose owner, upload progression, table binding and slot reclamation each example holds or lets go.
test-suite lua-engine-graphics-tests
    import: language
    type: exitcode-stdio-1.0
    ghc-options: -threaded -rtsopts
    main-is: Main.hs
    hs-source-dirs: test test-common
    other-modules:
        Test.LuaEngine.Graphics.Cancellation
        Test.LuaEngine.Graphics.Composed
        Test.LuaEngine.Graphics.Composition
        Test.LuaEngine.Graphics.Configuration
        Test.LuaEngine.Graphics.Fake
        Test.LuaEngine.Graphics.Faults
        Test.LuaEngine.Graphics.Lifecycle
        Test.LuaEngine.Graphics.Png
        Test.LuaEngine.Graphics.Pressure
        Test.LuaEngine.Graphics.Release
        Test.LuaEngine.Graphics.Rig
        Test.LuaEngine.Graphics.Spec
        Test.LuaEngine.Graphics.Stages
        Test.LuaEngine.Graphics.Teardown
        Test.LuaEngine.Graphics.Window.Fake
        Test.LuaEngine.Graphics.Window.Request
        Test.LuaEngine.Graphics.Window.Rig
        Test.LuaEngine.Graphics.Window.Spec
        Test.LuaEngine.Graphics.Windows
    build-depends:
        base >=4.22 && <4.23,
        array >=0.5 && <0.6,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        HUnit >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        time >=1.15 && <1.16,
        zlib >=0.7.1 && <0.8,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw ==0.1.0.0,
        hetoimasia-glfw:runtime-glfw ==0.1.0.0,
        hetoimasia-gpu-vulkan-diagnostics ==0.1.0.0,
        hetoimasia-gpu-vulkan-glfw ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine-graphics,
        hetoimasia-lua-engine:request,
        hetoimasia-lua-engine:texture,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua

-- The adapter's real-device suite, in the group `test.vulkan-lua-engine-native`: a window-free session of the
-- production host, started without a surface, in which a texture request finishes through verified reading,
-- bounded decoding and the production backend and the device's own evidence for it is read back. Like the
-- window integration's native suite it follows the native-suite rules (GLFW's session on the process main
-- thread with Hspec on another, the ambient Vulkan environment cleared, the diagnostic capture's verdict after
-- the last teardown, the run's consent), reimplemented here because AGENTS.md forbids importing another
-- component's spec helpers. Its executable is built in the group's preparation stage and run, without being
-- built, by `tools/vulkan/run.sh native`.
test-suite lua-engine-graphics-native-tests
    import: language
    type: exitcode-stdio-1.0
    ghc-options: -threaded -rtsopts
    default-extensions: PatternSynonyms
    main-is: Main.hs
    hs-source-dirs: native-test test-common
    other-modules:
        Test.LuaEngine.Graphics.Composition
        Test.LuaEngine.Graphics.Native.Consent
        Test.LuaEngine.Graphics.Native.Environment
        Test.LuaEngine.Graphics.Native.Frame
        Test.LuaEngine.Graphics.Native.Loader
        Test.LuaEngine.Graphics.Native.Session
        Test.LuaEngine.Graphics.Native.Spec
        Test.LuaEngine.Graphics.Native.Windows
        Test.LuaEngine.Graphics.Png
        Test.LuaEngine.Graphics.Windows
    c-sources: native-test/cbits/hetoimasia_lua_engine_graphics_native.c
    include-dirs: native-test/cbits
    install-includes: hetoimasia_lua_engine_graphics_native.h
    if os(linux)
        extra-libraries: dl
    build-depends:
        base >=4.22 && <4.23,
        array >=0.5 && <0.6,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        HUnit >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        time >=1.15 && <1.16,
        vulkan >=3.27 && <3.28,
        zlib >=0.7.1 && <0.8,
        hetoimasia-asset ==0.1.0.0,
        hetoimasia-asset-image ==0.1.0.0,
        hetoimasia-content ==0.1.0.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw ==0.1.0.0,
        hetoimasia-glfw:native-check ==0.1.0.0,
        hetoimasia-glfw:runtime-glfw ==0.1.0.0,
        hetoimasia-glfw:vulkan-interop ==0.1.0.0,
        hetoimasia-gpu-vulkan-diagnostics ==0.1.0.0,
        hetoimasia-gpu-vulkan-glfw ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native ==0.1.0.0,
        hetoimasia-lua-engine ==0.1.0.0,
        hetoimasia-lua-engine-graphics,
        hetoimasia-lua-engine:request,
        hetoimasia-lua-engine:texture,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-2d-oracle ==0.1.0.0,
        hetoimasia-render-2d-vulkan ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-scripting-lua ==0.1.0.0,
        hetoimasia-scripting-lua:runtime-lua
