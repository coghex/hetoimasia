cabal-version: 3.16
name: hetoimasia-gpu-vulkan-model
version: 0.1.0.0
synopsis: Pure GPU retention and frame-ownership model for Hetoimasia
description:
    Backend-private, binding-independent state and accounting for a graphics
    session: typed unforgeable identities for the session, device, targets,
    swapchain generations, image records, frame slots, recorded batches,
    submissions, presentations, managed resource generations and allocation
    attempts; separately tracked holds keyed by generation, so nothing is
    disposed of while any of them remains; frame ownership phases with the
    obligations each retains and the exits legal from it; validated finite
    admission budgets whose exhaustion is typed backpressure rather than
    failure; per-episode recovery accounting that nested helpers cannot
    replenish; and bounded round-robin owner progress against the foundation's
    injected monotonic clock.
    .
    Completion is supplied as abstract facts through an injected interface. This
    package proves no native completion, makes no Vulkan call and names no
    native type: it depends on the foundation library alone, and on neither the
    Vulkan binding, GLFW, the runtime nor a game, so its suite builds and runs
    without a Vulkan SDK.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/gpu-vulkan/model

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.GPU.Model
        Hetoimasia.GPU.Model.Budget
        Hetoimasia.GPU.Model.Identity
    -- The identity constructors, the hold ledger, the admission arithmetic, the
    -- recovery accounting, and the state machine itself: its representation
    -- (Records, State), the shared resolution and accounting it is edited
    -- through (Resolve, Accounting), the read-only queries and the one
    -- scheduling rule every transition applies (Work, Scheduling), the
    -- transitions grouped by responsibility, owner progress, and the read-only
    -- views. Hiding them is what makes an identity unforgeable: a client cannot
    -- build one, so every value a model is handed was issued by some model.
    -- The layering is described in docs/gpu_model.md.
    other-modules:
        Hetoimasia.GPU.Model.Internal.Accounting
        Hetoimasia.GPU.Model.Internal.Budget
        Hetoimasia.GPU.Model.Internal.Completion
        Hetoimasia.GPU.Model.Internal.Disposal
        Hetoimasia.GPU.Model.Internal.Frames
        Hetoimasia.GPU.Model.Internal.Generations
        Hetoimasia.GPU.Model.Internal.Hold
        Hetoimasia.GPU.Model.Internal.Identity
        Hetoimasia.GPU.Model.Internal.Memory
        Hetoimasia.GPU.Model.Internal.Observation
        Hetoimasia.GPU.Model.Internal.Presentation
        Hetoimasia.GPU.Model.Internal.Progress
        Hetoimasia.GPU.Model.Internal.Recording
        Hetoimasia.GPU.Model.Internal.Records
        Hetoimasia.GPU.Model.Internal.Recovery
        Hetoimasia.GPU.Model.Internal.Resolve
        Hetoimasia.GPU.Model.Internal.Resources
        Hetoimasia.GPU.Model.Internal.Scheduling
        Hetoimasia.GPU.Model.Internal.Session
        Hetoimasia.GPU.Model.Internal.State
        Hetoimasia.GPU.Model.Internal.Submission
        Hetoimasia.GPU.Model.Internal.TargetRecovery
        Hetoimasia.GPU.Model.Internal.Targets
        Hetoimasia.GPU.Model.Internal.Work
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        hetoimasia-foundation ==0.1.0.0

-- A test reference, never a production dependency: the pure best-fit block
-- placement #331 built and measured against VMA before the owner chose VMA for
-- production allocation (design decision D-38). It is kept because it states
-- best fit's rules exactly and is tested against them, so tests and the
-- allocator parity probe can compare other placements with it. Only test suites
-- may depend on it; the model library does not, and neither may any engine
-- library. See packages/gpu-vulkan/model/README.md.
library placement-reference
    import: language
    visibility: public
    hs-source-dirs: placement-reference
    exposed-modules:
        Hetoimasia.GPU.Model.Placement
    other-modules:
        Hetoimasia.GPU.Model.Internal.Placement.Allocator
        Hetoimasia.GPU.Model.Internal.Placement.BestFit
        Hetoimasia.GPU.Model.Internal.Placement.Config
        Hetoimasia.GPU.Model.Internal.Placement.Strategy
        Hetoimasia.GPU.Model.Internal.Placement.Types
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9

-- This package's own contracts. It depends on this library, the foundation, the
-- neutral `hetoimasia-test-support` library its opacity examples compile
-- external clients with, and third-party packages alone, so it builds and runs
-- with no Vulkan SDK present and is registered as the CPU validation group
-- `test.vulkan`.
test-suite gpu-model-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.GPU.Model.Budgets
        Test.GPU.Model.DeviceLoss
        Test.GPU.Model.Frames
        Test.GPU.Model.Holds
        Test.GPU.Model.Identities
        Test.GPU.Model.Memory
        Test.GPU.Model.Opacity
        Test.GPU.Model.Placement
        Test.GPU.Model.Progress
        Test.GPU.Model.Recovery
        Test.GPU.Model.Sequences
        Test.GPU.Model.Spec
        Test.GPU.Model.Support
    build-depends:
        base >=4.22 && <4.23,
        containers >=0.8 && <0.9,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        QuickCheck >=2.15 && <2.19,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-model:placement-reference,
        hetoimasia-test-support ==0.1.0.0
