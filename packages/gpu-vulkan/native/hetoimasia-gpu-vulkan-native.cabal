cabal-version: 3.16
name: hetoimasia-gpu-vulkan-native
version: 0.1.0.0
synopsis: The native Vulkan backend for Hetoimasia
description:
    The package that owns the Vulkan binding, the handles and the calls: VK-6's
    debug-utils messengers that deliver validation diagnostics into a
    diagnostics-package lifetime through a C-only callback, the record of this
    package's own FFI configuration, VK-9's shader adapter — GLSL compiled
    during the build by the pinned compiler, embedded as SPIR-V, with the
    compiler's identity a rebuild input — and VK-7's roots: the instance, the
    explicit messenger, the one shared device and the per-target surface
    records, with their profile, admission, device-loss latch and
    child-before-parent destruction over an open native layer — and VK-10's
    swapchain generations above them: the presentation profile and extent
    policy as pure decisions, and each target's generations built, replaced and
    destroyed by the model's identities and holds — and VK-11's
    renderer-facing boundary above them: managed resources keyed by the
    model's identities, a scoped recorder that retains every generation a
    command references before recording it, sealed single-use batches, readback
    memory, and the audited unsafe recording subset — and VK-12's frames above
    the recording: non-blocking acquisition, submission with one completion
    obligation per native submission, and safe abandonment through cleanup
    submissions and maintenance release. It depends on no window
    system: a surface arrives as its handle and the action that destroys it.
    .
    It is selected only by `cabal.project.vulkan`, so neither `cabal.project`
    nor `cabal.project.cpu` resolves the binding, the Vulkan headers or a loader.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md
-- Every file a shader splice reads is a source file, because Cabal decides
-- whether to run GHC at all from the files a package lists and never from
-- the ones a splice registers: a changed shader, include or fingerprint that
-- is not listed here leaves the build "Up to date".
--
-- `**/*.fingerprint` covers `shaders/toolchain.fingerprint`, which
-- `hetoimasia-shader-fingerprint` generates before every build and Git
-- ignores. A glob that matches nothing makes `cabal sdist` fail, so the
-- tracked test fixture `test/fixtures/foreign.fingerprint` keeps it
-- non-empty in a tree that has not generated one. A distribution made from a
-- tree that has carries that tree's fingerprint; it is never trusted there,
-- because the generator rewrites it and every splice checks it.
extra-source-files:
    cbits/hetoimasia_vulkan_native.h
    vendor/vma/vk_mem_alloc.h
    vendor/vma/LICENSE.txt
    **/*.fingerprint
    test/shaders/*.frag
    test/shaders/**/*.glsl
    test/fixtures/spirv/*.spv
    test/fixtures/spirv/*.vert
    test/fixtures/spirv/*.frag

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/gpu-vulkan/native

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings PatternSynonyms
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.GPU.Vulkan.Native.Allocator
        Hetoimasia.GPU.Vulkan.Native.Allocator.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Diagnostics
        Hetoimasia.GPU.Vulkan.Native.Frames
        Hetoimasia.GPU.Vulkan.Native.Frames.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Generations
        Hetoimasia.GPU.Vulkan.Native.Naming
        Hetoimasia.GPU.Vulkan.Native.Presentation
        Hetoimasia.GPU.Vulkan.Native.Profile
        Hetoimasia.GPU.Vulkan.Native.Recording
        Hetoimasia.GPU.Vulkan.Native.Recording.Shaders
        Hetoimasia.GPU.Vulkan.Native.Recording.ShaderInterfaces
        Hetoimasia.GPU.Vulkan.Native.Recording.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Roots
        Hetoimasia.GPU.Vulkan.Native.Roots.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Shader
        Hetoimasia.GPU.Vulkan.Native.Shader.Interface
        Hetoimasia.GPU.Vulkan.Native.Uploads
    -- VK-11's audited recording subset: the package's only genuine `unsafe`
    -- Vulkan imports. Private, so nothing outside the package can record
    -- through them; see the module and docs/gpu_backend.md, "The FFI audit".
    --
    -- Internal.Recording.* is the managed recording's implementation, split by
    -- responsibility (#265); Recording re-exports its public names unchanged.
    -- Each is private because it exports what clients must never reach:
    -- Layer is the native layer's shape, re-exported whole; State holds the
    -- records, the recording's representation and the handles' constructors,
    -- which Recording exports only abstractly; Construction, Recorder
    -- (whose Recorder's representation stays hidden), Batches, Readback and
    -- Disposal each own one stage of a generation's or a batch's life and
    -- expose steps, such as retiring completed batches, that only another
    -- stage may take. See packages/gpu-vulkan/native/README.md.
    --
    -- Internal.Frames.* is VK-12's acquisition, submission and abandonment
    -- and VK-13's presentation, split by responsibility as the recording is;
    -- Frames re-exports its public names. Each is private because it exports
    -- what clients must never reach: Layer is the native layer's shape,
    -- re-exported whole; State holds the slot, pool, frame, submission and
    -- presentation records and the constructor of Frames, which Frames exports
    -- only abstractly; Acquisition, Submission, Presentation, Abandonment and
    -- Progress each own one stage of a frame's life, and Abandonment exposes
    -- the cleanup submission only Progress may also make.
    --
    -- Internal.Generations.* is the swapchain generations' implementation,
    -- split by responsibility (#266); Generations re-exports its public names
    -- unchanged. Each is private because it exports what clients must never
    -- reach: State holds the target and generation records and the
    -- constructor of Generations, which Generations exports only abstractly;
    -- Uses holds GenerationUse's constructor; Disposal, Reconciliation, Step,
    -- Retirement and Observation each own one part of a generation's or a
    -- target's life and expose steps, such as a single target's
    -- reconciliation or the model's progress turn, that only another part may
    -- take.
    --
    -- Internal.Reclamation is VK-14's allocation recovery: one bounded
    -- reclamation pass through the disposers each layer registers with the
    -- roots, and the one retry the model's allocation attempt permits. It is
    -- private because only the operations that own a failed allocation may
    -- decide it had no effect. Internal.Generations.Surface is VK-14's
    -- surface-loss recovery for a target's generations, which the public
    -- Generations re-exports.
    other-modules:
        Hetoimasia.GPU.Vulkan.Native.Internal.Allocation
        Hetoimasia.GPU.Vulkan.Native.Internal.Commands
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Abandonment
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Acquisition
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Frameless
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Layer
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Loss
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Presentation
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Progress
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.State
        Hetoimasia.GPU.Vulkan.Native.Internal.Frames.Submission
        Hetoimasia.GPU.Vulkan.Native.Internal.Reclamation
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Disposal
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Observation
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Reconciliation
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Retirement
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.State
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Step
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Surface
        Hetoimasia.GPU.Vulkan.Native.Internal.Generations.Uses
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Batches
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Construction
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Disposal
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Layer
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Readback
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.Recorder
        Hetoimasia.GPU.Vulkan.Native.Internal.Recording.State
        Hetoimasia.GPU.Vulkan.Native.Internal.Uploads
        Hetoimasia.GPU.Vulkan.Native.Internal.Vma
    -- The messenger callback, and the compile-time check that the diagnostics
    -- package's layout mirror is the Vulkan headers' layout. The headers come
    -- from the provisioned Vulkan prefix `tools/vulkan/run.sh` passes to
    -- Cabal; the capture header from the diagnostics package.
    c-sources: cbits/hetoimasia_vulkan_native.c
    include-dirs: cbits
    cc-options: -std=c11 -Wall -Wextra -Werror
    -- GRS-11's VMA shim: the engine-owned C entries the private
    -- Internal.Vma imports unsafe, with D-40's device-memory callbacks
    -- counting in C — the configuration #361 qualified. It includes the
    -- vendored `vk_mem_alloc.h` for declarations only; VMA itself is the copy
    -- the pinned `VulkanMemoryAllocator` package compiles, with the flags
    -- `cabal.project.vulkan` constrains. Compiled as the qualified shim was.
    -- See docs/toolchain.md, "VMA".
    cxx-sources: cbits/hetoimasia_vma.cpp
    include-dirs: vendor/vma
    cxx-options: -std=c++17 -O2 -Wall -Wextra -Werror
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        stm >=2.5.3 && <2.6,
        template-haskell >=2.24 && <2.25,
        text >=2.1 && <2.2,
        vector >=0.13 && <0.14,
        vulkan >=3.27 && <3.28,
        vulkan-utils ==0.5.11.0,
        -- Only for the VMA it compiles; no module of it is imported.
        VulkanMemoryAllocator ==0.11.1.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-gpu-vulkan-diagnostics ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native:shader-toolchain

-- The compile configuration, the fingerprint, the checks that decide whether
-- the toolchain is trusted, and the compile itself. It depends on neither the
-- binding nor Template Haskell, so the fingerprint generator below builds
-- without a loader and the runtime compile entry is ordinary IO.
library shader-toolchain
    visibility: private
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    hs-source-dirs: shader-toolchain
    exposed-modules:
        Hetoimasia.GPU.Vulkan.Native.Shader.Reflect
        Hetoimasia.GPU.Vulkan.Native.Shader.Toolchain
    other-modules:
        Hetoimasia.GPU.Vulkan.Native.Shader.Json
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        process >=1.6 && <1.7,
        temporary >=1.3 && <1.4,
        transformers >=0.6 && <0.7

-- Run before every build that splices shaders: it validates the wrapper and
-- the native manifest and rewrites the fingerprint only when it changed.
-- `tools/vulkan/run.sh` runs it before every build and test; see README.md.
executable hetoimasia-shader-fingerprint
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    hs-source-dirs: fingerprint
    main-is: Main.hs
    build-depends:
        base >=4.22 && <4.23,
        hetoimasia-gpu-vulkan-native:shader-toolchain

-- VK-9's shader contract. It needs the provisioned compiler, because its
-- verification pair is compiled while it is built, and nothing else native:
-- it creates no Vulkan object, opens no window and reads no consent.
test-suite shader-tests
    type: exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options:
        -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
        -threaded -rtsopts
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Test.Shader.Checked
        Test.Shader.Constants
        Test.Shader.Fragment
        Test.Shader.InterfaceSpec
        Test.Shader.Interfaces
        Test.Shader.Malformed
        Test.Shader.Spec
        Test.Shader.Vertex
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        temporary >=1.3 && <1.4,
        hetoimasia-gpu-vulkan-native,
        hetoimasia-gpu-vulkan-native:shader-toolchain,
        hetoimasia-test-support ==0.1.0.0

-- The roots' headless examples: the profile's decisions, and every ownership
-- decision of the roots over a stand-in native layer that fails at a chosen
-- step. They make no native call and create no device; the executable links
-- the loader only because the library does, so it is built and run through
-- `tools/vulkan/run.sh test` — the group `test.vulkan-headless` — which points
-- Cabal at the provisioned prefix. It shares `test/` with the shader suite and has its own
-- main. Its recording and generations visibility examples typecheck external
-- clients against the built package through `hetoimasia-test-support`'s
-- harness, with the `ghc` on PATH, as the shader suite's client does.
test-suite native-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: RootsMain.hs
    hs-source-dirs: test
    other-modules:
        Test.GPU.Vulkan.Native.Allocation
        Test.GPU.Vulkan.Native.AllocatorStandIn
        Test.GPU.Vulkan.Native.AllocatorVisibility
        Test.GPU.Vulkan.Native.Checked
        Test.GPU.Vulkan.Native.Drawing
        Test.GPU.Vulkan.Native.Frameless
        Test.GPU.Vulkan.Native.Frames
        Test.GPU.Vulkan.Native.FramesConstruction
        Test.GPU.Vulkan.Native.FramesPresentation
        Test.GPU.Vulkan.Native.FramesRig
        Test.GPU.Vulkan.Native.FramesStandIn
        Test.GPU.Vulkan.Native.FramesVisibility
        Test.GPU.Vulkan.Native.Generations
        Test.GPU.Vulkan.Native.GenerationsVisibility
        Test.GPU.Vulkan.Native.Offscreen
        Test.GPU.Vulkan.Native.Presentation
        Test.GPU.Vulkan.Native.Profile
        Test.GPU.Vulkan.Native.Reclamation
        Test.GPU.Vulkan.Native.Recording
        Test.GPU.Vulkan.Native.RecordingStandIn
        Test.GPU.Vulkan.Native.RecordingVisibility
        Test.GPU.Vulkan.Native.Roots
        Test.GPU.Vulkan.Native.StandIn
        Test.GPU.Vulkan.Native.Terminal
        Test.GPU.Vulkan.Native.Uploads
    ghc-options: -threaded -rtsopts
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        vulkan >=3.27 && <3.28,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native,
        hetoimasia-test-support ==0.1.0.0

-- The allocator probe, local apparatus with two modes. By default it is
-- GRS-18's qualification of the production VMA integration (#361, D-39): a
-- windowless device of its own, one externally synchronised allocator per
-- pass, and the engine's VMA calls made from a C driver and from Haskell
-- through the Hackage binding, timed per call and over the four retained
-- traces translated into real buffers and images, with D-40's block
-- accounting, completion-deferred frees and synchronization validation. With
-- `--virtual-block-parity` it is GRS-1's parity probe (#331, D-14), kept as
-- the evidence for D-38: the committed traces replayed into one fixed block
-- through the pure placement reference, a mutable prototype of it and VMA's
-- virtual block, judged against #331's requirement 7. It is deliberately not
-- a validation group — only the three required Vulkan groups may run a
-- Vulkan-project command — so nothing selects it; it is built and run on
-- request through `tools/vulkan/run.sh`, whose `HETOIMASIA_VMA_FOREIGN_CALLS`
-- chooses the binding's call safety. Here VMA is the copy the pinned Hackage
-- `VulkanMemoryAllocator` package compiles, reaching this suite alone. It is
-- linked with the threaded runtime the engine uses. See
-- probe/allocator-parity/README.md, docs/gpu_vma_qualification_record.md and
-- docs/gpu_allocator_parity_record.md.
test-suite allocator-parity-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: probe/allocator-parity
    other-modules:
        Parity.Differential
        Parity.Haskell
        Parity.Mutable
        Parity.Reference
        Parity.Replay
        Parity.Report
        Parity.Trace
        Parity.Vma
        Production
        Production.Deferred
        Production.Device
        Production.Driver
        Production.Script
        Prototype.MutableBestFit
    cxx-sources:
        probe/allocator-parity/cbits/vma_replay.cpp
        probe/allocator-parity/cbits/vma_production.cpp
    cxx-options: -std=c++17 -O2 -Wall -Wextra -Werror
    -- `-T` keeps the runtime's statistics, which the allocation and collection
    -- figures read; `-rtsopts` lets a run choose its nursery (`+RTS -A…`).
    -- `-threaded` because a safe foreign call's cost, and whether another
    -- Haskell thread can run during one, depend on it.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-T"
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        process >=1.6 && <1.7,
        vector >=0.13 && <0.14,
        vulkan >=3.27 && <3.28,
        VulkanMemoryAllocator ==0.11.1.0,
        hetoimasia-gpu-vulkan-model:placement-reference
