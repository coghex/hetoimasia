cabal-version: 3.16
name: hetoimasia-gpu-vulkan-native
version: 0.1.0.0
synopsis: The native Vulkan backend for Hetoimasia
description:
    The package that owns the Vulkan binding, the handles and the calls: VK-6's
    debug-utils messengers that deliver validation diagnostics into a
    diagnostics-package lifetime through a C-only callback, the record of this
    package's own FFI configuration, VK-9's shader adapter — GLSL compiled
    during the build by the pinned compiler, embedded as SPIR-V, with the
    compiler's identity a rebuild input — and VK-7's roots: the instance, the
    explicit messenger, the one shared device and the per-target surface
    records, with their profile, admission, device-loss latch and
    child-before-parent destruction over an open native layer — and VK-10's
    swapchain generations above them: the presentation profile and extent
    policy as pure decisions, and each target's generations built, replaced and
    destroyed by the model's identities and holds — and VK-11's
    renderer-facing boundary above them: managed resources keyed by the
    model's identities, a scoped recorder that retains every generation a
    command references before recording it, sealed single-use batches, readback
    memory, and the audited unsafe recording subset. It depends on no window
    system: a surface arrives as its handle and the action that destroys it.
    .
    It is selected only by `cabal.project.vulkan`, so neither `cabal.project`
    nor `cabal.project.cpu` resolves the binding, the Vulkan headers or a loader.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md
-- Every file a shader splice reads is a source file, because Cabal decides
-- whether to run GHC at all from the files a package lists and never from
-- the ones a splice registers: a changed shader, include or fingerprint that
-- is not listed here leaves the build "Up to date".
--
-- `**/*.fingerprint` covers `shaders/toolchain.fingerprint`, which
-- `hetoimasia-shader-fingerprint` generates before every build and Git
-- ignores. A glob that matches nothing makes `cabal sdist` fail, so the
-- tracked test fixture `test/fixtures/foreign.fingerprint` keeps it
-- non-empty in a tree that has not generated one. A distribution made from a
-- tree that has carries that tree's fingerprint; it is never trusted there,
-- because the generator rewrites it and every splice checks it.
extra-source-files:
    cbits/hetoimasia_vulkan_native.h
    **/*.fingerprint
    test/shaders/*.frag
    test/shaders/**/*.glsl

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/gpu-vulkan/native

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings PatternSynonyms
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.GPU.Vulkan.Native.Diagnostics
        Hetoimasia.GPU.Vulkan.Native.Generations
        Hetoimasia.GPU.Vulkan.Native.Naming
        Hetoimasia.GPU.Vulkan.Native.Presentation
        Hetoimasia.GPU.Vulkan.Native.Profile
        Hetoimasia.GPU.Vulkan.Native.Recording
        Hetoimasia.GPU.Vulkan.Native.Recording.Shaders
        Hetoimasia.GPU.Vulkan.Native.Recording.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Roots
        Hetoimasia.GPU.Vulkan.Native.Roots.Vulkan
        Hetoimasia.GPU.Vulkan.Native.Shader
    -- VK-11's audited recording subset: the package's only genuine `unsafe`
    -- Vulkan imports. Private, so nothing outside the package can record
    -- through them; see the module and docs/gpu_backend.md, "The FFI audit".
    other-modules:
        Hetoimasia.GPU.Vulkan.Native.Internal.Commands
    -- The messenger callback, and the compile-time check that the diagnostics
    -- package's layout mirror is the Vulkan headers' layout. The headers come
    -- from the provisioned Vulkan prefix `tools/vulkan/run.sh` passes to
    -- Cabal; the capture header from the diagnostics package.
    c-sources: cbits/hetoimasia_vulkan_native.c
    include-dirs: cbits
    cc-options: -std=c11 -Wall -Wextra -Werror
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        stm >=2.5.3 && <2.6,
        template-haskell >=2.24 && <2.25,
        text >=2.1 && <2.2,
        vector >=0.13 && <0.14,
        vulkan >=3.27 && <3.28,
        vulkan-utils ==0.5.11.0,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-gpu-vulkan-diagnostics ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native:shader-toolchain

-- The compile configuration, the fingerprint, the checks that decide whether
-- the toolchain is trusted, and the compile itself. It depends on neither the
-- binding nor Template Haskell, so the fingerprint generator below builds
-- without a loader and the runtime compile entry is ordinary IO.
library shader-toolchain
    visibility: private
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    hs-source-dirs: shader-toolchain
    exposed-modules:
        Hetoimasia.GPU.Vulkan.Native.Shader.Toolchain
    other-modules:
        Hetoimasia.GPU.Vulkan.Native.Shader.Json
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        process >=1.6 && <1.7,
        temporary >=1.3 && <1.4,
        transformers >=0.6 && <0.7

-- Run before every build that splices shaders: it validates the wrapper and
-- the native manifest and rewrites the fingerprint only when it changed.
-- `tools/vulkan/run.sh` runs it before every build and test; see README.md.
executable hetoimasia-shader-fingerprint
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    hs-source-dirs: fingerprint
    main-is: Main.hs
    build-depends:
        base >=4.22 && <4.23,
        hetoimasia-gpu-vulkan-native:shader-toolchain

-- VK-9's shader contract. It needs the provisioned compiler, because its
-- verification pair is compiled while it is built, and nothing else native:
-- it creates no Vulkan object, opens no window and reads no consent.
test-suite shader-tests
    type: exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options:
        -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
        -threaded -rtsopts
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Test.Shader.Constants
        Test.Shader.Fragment
        Test.Shader.Spec
        Test.Shader.Vertex
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        cryptohash-sha256 >=0.11.102 && <0.12,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        temporary >=1.3 && <1.4,
        hetoimasia-gpu-vulkan-native,
        hetoimasia-gpu-vulkan-native:shader-toolchain,
        hetoimasia-test-support ==0.1.0.0

-- The roots' headless examples: the profile's decisions, and every ownership
-- decision of the roots over a stand-in native layer that fails at a chosen
-- step. They make no native call and create no device; the executable links
-- the loader only because the library does, so it is built and run through
-- `tools/vulkan/run.sh test` — the group `test.vulkan-headless` — which points
-- Cabal at the provisioned prefix. It shares `test/` with the shader suite and has its own
-- main.
test-suite native-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: RootsMain.hs
    hs-source-dirs: test
    other-modules:
        Test.GPU.Vulkan.Native.Generations
        Test.GPU.Vulkan.Native.Presentation
        Test.GPU.Vulkan.Native.Profile
        Test.GPU.Vulkan.Native.Recording
        Test.GPU.Vulkan.Native.RecordingStandIn
        Test.GPU.Vulkan.Native.Roots
        Test.GPU.Vulkan.Native.StandIn
    ghc-options: -threaded -rtsopts
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        vulkan >=3.27 && <3.28,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-gpu-vulkan-model ==0.1.0.0,
        hetoimasia-gpu-vulkan-native
