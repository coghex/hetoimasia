cabal-version: 3.16
name: hetoimasia-glfw
version: 0.1.0.0
synopsis: GLFW 3.4 native binding and main-thread session for Hetoimasia
description:
    A small private binding to upstream GLFW 3.4 and one scoped session owned by
    the process main thread: exclusive initialization and termination, bounded
    evidence of what the native error callback reported, a monitor inventory
    with disconnect-safe identities, scoped NoAPI windows that publish what the
    platform observed through snapshots, and
    bounded window command admission with persistent completion tickets, and
    bounded per-window input feeds whose native key, character, button, cursor,
    and scroll callbacks publish through an acknowledged reset. Its main library
    depends on the foundation library and not on the runtime. The
    separate public runtime-glfw sublibrary composes a window host, its
    dynamically created and independently closed windows, and its supervised
    owner loop with the runtime's application lifecycle, and no library depends
    on it. No component imports a game, scripting, or rendering module.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.12.2
extra-doc-files: README.md
extra-source-files:
    native/cbits/hetoimasia_glfw.h

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/glfw

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

-- The session, window, and monitor models: exclusivity, thread checks, staged
-- construction and rollback, bounded error capture, window observations, the
-- monitor inventory and its identities, contained callbacks, window command
-- admission, execution, and completion, and bounded input feeds with their
-- acknowledged reset, bounded input staging at the window callbacks, and the
-- pure window attachment model, written over a table of native operations. It binds nothing, so the test seam
-- can drive it without linking GLFW.
library model
    import: language
    visibility: private
    hs-source-dirs: model
    exposed-modules:
        Hetoimasia.GLFW.Internal.Attachment
        Hetoimasia.GLFW.Internal.Attribute
        Hetoimasia.GLFW.Internal.Capture
        Hetoimasia.GLFW.Internal.Control
        Hetoimasia.GLFW.Internal.Input
        Hetoimasia.GLFW.Internal.Mode
        Hetoimasia.GLFW.Internal.Monitor
        Hetoimasia.GLFW.Internal.Session
        Hetoimasia.GLFW.Internal.Window
        Hetoimasia.GLFW.Internal.Command
    build-depends:
        base >=4.21 && <4.22,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        deepseq >=1.5.1 && <1.6,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0

-- The foreign imports, the thread-identity shim, and the production operation
-- table. Native handles and ABI declarations never leave this package.
library native
    import: language
    visibility: private
    hs-source-dirs: native
    exposed-modules:
        Hetoimasia.GLFW.Internal.Native
    c-sources: native/cbits/hetoimasia_glfw.c
    include-dirs: native/cbits
    pkgconfig-depends: glfw3 >=3.4 && <3.5
    -- The ordinary-link requirements the native manifest records beyond the
    -- archive itself (`pkg-config --libs --static glfw3`). The link-declaration
    -- examples in glfw-tests assert that these agree with the manifest.
    if os(darwin)
        frameworks: Cocoa IOKit CoreFoundation
    if os(linux)
        extra-libraries: rt m dl
    build-depends:
        base >=4.21 && <4.22,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-glfw:model

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.GLFW.Command
        Hetoimasia.GLFW.Input
        Hetoimasia.GLFW.Mode
        Hetoimasia.GLFW.Monitor
        Hetoimasia.GLFW.Session
        Hetoimasia.GLFW.Window
    build-depends:
        base >=4.21 && <4.22,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw:model,
        hetoimasia-glfw:native

-- The runtime integration: a window host built as a scoped application
-- dependency, owning its windows through a scoped collection and giving each
-- its own command port, the supervised owner loop that processes native events
-- and is the only production executor of those ports, and the host's quiescence
-- action. It is the one library that depends on both the GLFW library and the
-- runtime, and no library depends on it. It uses the private model for execution
-- and event processing, and exports none of it.
library runtime-glfw
    import: language
    visibility: public
    hs-source-dirs: runtime-glfw
    exposed-modules:
        Hetoimasia.Runtime.GLFW
    build-depends:
        base >=4.21 && <4.22,
        hetoimasia-glfw:runtime-glfw-core

-- The runtime integration's implementation, including the test-only host hooks
-- the dynamic window examples use to deliver a cancellation at a precise point.
-- Private, so no package outside this one can name them; the public
-- runtime-glfw sublibrary re-exports everything else.
library runtime-glfw-core
    import: language
    visibility: private
    hs-source-dirs: runtime-glfw-core
    exposed-modules:
        Hetoimasia.Runtime.GLFW.Internal
    build-depends:
        base >=4.21 && <4.22,
        containers >=0.7 && <0.8,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-glfw,
        hetoimasia-glfw:model

-- The private test seam: the real session model over a scripted native
-- library, for CPU examples that must not initialize GLFW. It is public so the
-- opacity examples' external clients can be given it; it exposes no native handle
-- and no session constructor, and links no native library.
library seam
    import: language
    visibility: public
    hs-source-dirs: seam
    exposed-modules:
        Hetoimasia.GLFW.Seam
    build-depends:
        base >=4.21 && <4.22,
        hetoimasia-glfw:seam-core

-- The seam's implementation, including the window drivers that deliver
-- scripted callbacks and change close intent, and the private window command
-- executor. Private, so no package outside this one can name them; the public
-- seam re-exports everything else.
library seam-core
    import: language
    visibility: private
    hs-source-dirs: seam-core
    exposed-modules:
        Hetoimasia.GLFW.Internal.Seam
    build-depends:
        base >=4.21 && <4.22,
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-glfw:model

-- The headless Hspec suite: the session examples over the public test seam,
-- the window model, window command, window control, window host, dynamic
-- window, monitor inventory, input feed, and window mode examples that use the
-- private window and monitor drivers, the private command executor, and the
-- host's private test hooks, the pure window attachment model examples, the
-- link-declaration check against the native
-- manifest, and the external-client opacity examples. It initializes no GLFW,
-- opens no window, and needs no display; it links the pinned native SDK only
-- through the libraries it depends on. Every library the suite or its external
-- clients use is declared here, public and private, so none is built only
-- because another component happens to depend on it.
test-suite glfw-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.GLFW.Attachment
        Test.GLFW.Command
        Test.GLFW.Control
        Test.GLFW.Dynamic
        Test.GLFW.Host
        Test.GLFW.Input
        Test.GLFW.Linking
        Test.GLFW.Mode
        Test.GLFW.Monitor
        Test.GLFW.Opacity
        Test.GLFW.Session
        Test.GLFW.Spec
        Test.GLFW.Wake
        Test.GLFW.Window
    ghc-options: -threaded -rtsopts
    build-depends:
        base >=4.21 && <4.22,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0,
        hetoimasia-glfw,
        hetoimasia-glfw:model,
        hetoimasia-glfw:runtime-glfw,
        hetoimasia-glfw:runtime-glfw-core,
        hetoimasia-glfw:seam,
        hetoimasia-glfw:seam-core

-- The native Hspec suite. The executable's process main thread owns one shared
-- production session and serves the operations examples dispatch to it from
-- Hspec's worker thread; examples needing a session of their own run in a
-- private child process of this same executable. It needs a windowing session —
-- Cocoa locally, an isolated X11 display in the test.glfw-native validation
-- group — so it is neither part of glfw-tests nor of the CPU groups, and
-- `cabal build all` compiles it without running it. It enters no session and
-- starts no child without the per-run consent Test.GLFW.Native.Consent reads:
-- the human's HETOIMASIA_NATIVE_SESSION=desktop on one approved command, or
-- the value tools/display/x11.sh gives the command it isolates.
test-suite glfw-native-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: native-tests
    other-modules:
        Test.GLFW.Native.Consent
        Test.GLFW.Native.Control
        Test.GLFW.Native.Fixture
        Test.GLFW.Native.Guard
        Test.GLFW.Native.Harness
        Test.GLFW.Native.Host
        Test.GLFW.Native.Input
        Test.GLFW.Native.Mode
        Test.GLFW.Native.Monitor
        Test.GLFW.Native.Private
        Test.GLFW.Native.Session
        Test.GLFW.Native.Spec
        Test.GLFW.Native.Support
        Test.GLFW.Native.Wake
        Test.GLFW.Native.Window
    ghc-options: -threaded
    build-depends:
        base >=4.21 && <4.22,
        hspec >=2.11 && <3,
        hspec-core >=2.11 && <2.12,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-glfw,
        hetoimasia-glfw:model,
        hetoimasia-glfw:native,
        hetoimasia-glfw:runtime-glfw
