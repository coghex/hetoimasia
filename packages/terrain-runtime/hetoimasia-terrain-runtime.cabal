cabal-version: 3.16
name: hetoimasia-terrain-runtime
version: 0.1.0.0
synopsis: The scoped transactional terrain service for Hetoimasia
description:
    The terrain arena's service (TRA-4): one dedicated owner thread that is
    the sole writer of arena contents, bounded asynchronous loading and eviction
    that execute the residency model's decisions against real resident detail,
    atomic whole-cell removal that commits its content, revision and successful
    settlement in one arbitration with cancellation and the parent session's
    admission, immutable borrowed snapshots, offload and reload from the
    immutable source plus canonical retained removals, and an orderly close. It
    also holds the pure model of the temporary store (TRA-20): the private page
    codec, copy-on-write indexes, allocator and retirement work, staged
    transaction planning, pinned readers, the allowance and the edit bank's
    admission, with no file, thread or clock. It depends on the pure terrain
    package and the foundation and runtime services; it has no Lua, window,
    renderer, GPU, native or game dependency.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Game
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/terrain-runtime

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax OverloadedStrings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Terrain.Runtime
        Hetoimasia.Terrain.Runtime.Settlement
        Hetoimasia.Terrain.Runtime.Storage
        Hetoimasia.Terrain.Runtime.Store
        Hetoimasia.Terrain.Runtime.Store.Admission
        Hetoimasia.Terrain.Runtime.Supervised
    -- The state, the transactions and the owner behind the public interface; a
    -- client cannot import them.
    other-modules:
        Hetoimasia.Terrain.Runtime.Internal.Content
        Hetoimasia.Terrain.Runtime.Internal.Core
        Hetoimasia.Terrain.Runtime.Internal.Owner
        Hetoimasia.Terrain.Runtime.Internal.Snapshot
        Hetoimasia.Terrain.Runtime.Internal.Types
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-runtime:storage,
        hetoimasia-terrain-runtime:store

-- The temporary store's pure model (TRA-20): the page codec and CRC32C, the
-- copy-on-write indexes, the allocator and retirement work, transaction planning,
-- readers, reclamation and the allowance. Being private it is visible to no client;
-- the public facade `Hetoimasia.Terrain.Runtime.Store` and `...Store.Admission`
-- re-export the narrow interface, and this package's own suite reaches the
-- implementation through it to check the codec, the trees and the allocator
-- against independent references. It performs no I/O, starts no thread and has no
-- STM, Lua, window, GPU or game dependency.
library store
    import: language
    visibility: private
    hs-source-dirs: store
    exposed-modules:
        Hetoimasia.Terrain.Runtime.Store.Internal.Admission
        Hetoimasia.Terrain.Runtime.Store.Internal.Crc32c
        Hetoimasia.Terrain.Runtime.Store.Internal.Format
        Hetoimasia.Terrain.Runtime.Store.Internal.Model
        Hetoimasia.Terrain.Runtime.Store.Internal.Page
        Hetoimasia.Terrain.Runtime.Store.Internal.Plan
        Hetoimasia.Terrain.Runtime.Store.Internal.Records
        Hetoimasia.Terrain.Runtime.Store.Internal.State
        Hetoimasia.Terrain.Runtime.Store.Internal.Tree
    build-depends:
        array >=0.5 && <0.6,
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hetoimasia-terrain ==0.1.0.0

-- The storage backend (TRA-21): the private temporary file of an arena, its
-- qualified native reservation, the two I/O workers and the bounded queue. It
-- performs the effects the pure store model describes and publishes nothing: no
-- root, revision or request result is ever decided here. The native shim is the
-- one C source; the backend has no Lua, window, GPU or game dependency.
library storage
    import: language
    visibility: private
    hs-source-dirs: storage
    exposed-modules:
        Hetoimasia.Terrain.Runtime.Storage.Internal.File
        Hetoimasia.Terrain.Runtime.Storage.Internal.Native
        Hetoimasia.Terrain.Runtime.Storage.Internal.Service
        Hetoimasia.Terrain.Runtime.Storage.Internal.Types
        Hetoimasia.Terrain.Runtime.Storage.Internal.Volume
    c-sources: storage/cbits/hetoimasia_terrain_storage.c
    include-dirs: storage/cbits
    cc-options: -std=c11 -Wall -Wextra -Werror
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        stm >=2.5.3 && <2.6,
        text >=2.1 && <2.2,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-runtime:store

-- This package's own contracts, registered as the CPU validation group
-- `test.terrain-runtime`. The suite drives the production service with
-- controlled gates and no timing sleep; every thread it starts is owned through
-- `Test.Support.Owned`.
test-suite terrain-runtime-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    -- The allocation observations read the runtime's counters, which exist only
    -- when the program is started with -T.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-T"
    other-modules:
        Test.TerrainRuntime.Basic
        Test.TerrainRuntime.Budgets
        Test.TerrainRuntime.Closure
        Test.TerrainRuntime.Credits
        Test.TerrainRuntime.Fixtures
        Test.TerrainRuntime.Hardening
        Test.TerrainRuntime.Interleaving
        Test.TerrainRuntime.Lifecycle
        Test.TerrainRuntime.Limits
        Test.TerrainRuntime.Offload
        Test.TerrainRuntime.Opacity
        Test.TerrainRuntime.Isolation
        Test.TerrainRuntime.Oracle
        Test.TerrainRuntime.Output
        Test.TerrainRuntime.OutputSpec
        Test.TerrainRuntime.Parallel
        Test.TerrainRuntime.Runner
        Test.TerrainRuntime.Races
        Test.TerrainRuntime.Revalidation
        Test.TerrainRuntime.Usage
        Test.TerrainRuntime.Spec
        Test.TerrainRuntime.Store.AdmissionSpec
        Test.TerrainRuntime.Store.Allowance
        Test.TerrainRuntime.Store.Boundary
        Test.TerrainRuntime.Store.Bounds
        Test.TerrainRuntime.Store.Codec
        Test.TerrainRuntime.Store.Cycles
        Test.TerrainRuntime.Store.Depth
        Test.TerrainRuntime.Store.Evidence
        Test.TerrainRuntime.Store.Faults
        Test.TerrainRuntime.Store.Fuzz
        Test.TerrainRuntime.Store.FuzzTrees
        Test.TerrainRuntime.Store.Harness
        Test.TerrainRuntime.Store.History
        Test.TerrainRuntime.Store.Keys
        Test.TerrainRuntime.Store.Memory
        Test.TerrainRuntime.Store.Protocol
        Test.TerrainRuntime.Store.Rebalance
        Test.TerrainRuntime.Store.Large
        Test.TerrainRuntime.Store.Scattered
        Test.TerrainRuntime.Store.Identity
        Test.TerrainRuntime.Store.Ownership
        Test.TerrainRuntime.Store.Readers
        Test.TerrainRuntime.Store.Reference
        Test.TerrainRuntime.Store.Replay
        Test.TerrainRuntime.Store.Scenes
        Test.TerrainRuntime.Store.Trees
        Test.TerrainRuntime.Store.Workload
        Test.TerrainRuntime.Storage.Boundary
        Test.TerrainRuntime.Storage.Classes
        Test.TerrainRuntime.Storage.Fixture
        Test.TerrainRuntime.Storage.Harness
        Test.TerrainRuntime.Storage.Growth
        Test.TerrainRuntime.Storage.Io
        Test.TerrainRuntime.Storage.Lifecycle
        Test.TerrainRuntime.Storage.Lifetime
        Test.TerrainRuntime.Storage.Memory
        Test.TerrainRuntime.Storage.Opacity
        Test.TerrainRuntime.Storage.Open
        Test.TerrainRuntime.Storage.ProbeSpec
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hspec >=2.11 && <3,
        hspec-core >=2.11 && <3,
        process >=1.6 && <1.7,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-runtime ==0.1.0.0,
        hetoimasia-terrain-runtime:storage,
        hetoimasia-terrain-runtime:store,
        hetoimasia-test-support ==0.1.0.0

-- The real-platform qualification of the storage backend (TRA-21, requirement 9): the
-- production native backend on a bounded, disposable volume of the platform it runs on,
-- named by a pointer file the setup scripts under tools/terrain-storage/ write. It is an
-- explicit local probe (validation group `test.terrain-storage-qualification`, optional,
-- category probe, no CI route): it fills a capped volume, so it is never selected by an
-- affected path or a routine suite command, and it refuses to run anywhere else.
test-suite terrain-storage-probe
    import: language
    type: exitcode-stdio-1.0
    main-is: ProbeMain.hs
    hs-source-dirs: probe, test
    ghc-options: -threaded -rtsopts "-with-rtsopts=-T"
    other-modules:
        Test.TerrainRuntime.Isolation
        Test.TerrainRuntime.Output
        Test.TerrainRuntime.Storage.Fixture
        Test.TerrainRuntime.Storage.Harness
        Test.TerrainRuntime.Storage.ProbeSpec
        Test.TerrainRuntime.Store.Harness
        Test.TerrainRuntime.Store.Reference
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        hspec >=2.11 && <3,
        hspec-core >=2.11 && <3,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
        hetoimasia-foundation ==0.1.0.0,
        hetoimasia-runtime ==0.1.0.0,
        hetoimasia-terrain ==0.1.0.0,
        hetoimasia-terrain-runtime ==0.1.0.0,
        hetoimasia-terrain-runtime:storage,
        hetoimasia-terrain-runtime:store,
        hetoimasia-test-support ==0.1.0.0

-- The full depth of the store families the routine suite bounds: every reduced or moved family at its
-- complete original parameters. An explicit local probe (validation group `test.terrain-runtime-full-depth`,
-- optional, category probe, no CI route): it takes about a quarter of an hour, so it is never selected by an affected
-- path or by a routine suite command. A pure model: no file, thread or clock; one example reads the runtime's allocation
-- counters, so every example runs alone on one capability behind the routine suite's isolation guard.
test-suite terrain-runtime-full-depth-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: FullMain.hs
    hs-source-dirs: full, test
    ghc-options: -threaded -rtsopts "-with-rtsopts=-T"
    other-modules:
        Test.TerrainRuntime.Output
        Test.TerrainRuntime.Isolation
        Test.TerrainRuntime.Runner
        Test.TerrainRuntime.Store.Bounds
        Test.TerrainRuntime.Store.Cycles
        Test.TerrainRuntime.Store.Depth
        Test.TerrainRuntime.Store.Evidence
        Test.TerrainRuntime.Store.Fuzz
        Test.TerrainRuntime.Store.FuzzTrees
        Test.TerrainRuntime.Store.Harness
        Test.TerrainRuntime.Store.History
        Test.TerrainRuntime.Store.Large
        Test.TerrainRuntime.Store.Protocol
        Test.TerrainRuntime.Store.Rebalance
        Test.TerrainRuntime.Store.Reference
        Test.TerrainRuntime.Store.Scattered
        Test.TerrainRuntime.Store.Scenes
        Test.TerrainRuntime.Store.Trees
        Test.TerrainRuntime.Store.Workload
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        directory >=1.3 && <1.4,
        hspec >=2.11 && <3,
        hspec-core >=2.11 && <3,
        stm >=2.5.3 && <2.6,
        temporary >=1.3 && <1.4,
        text >=2.1 && <2.2,
        unix >=2.8 && <2.9,
