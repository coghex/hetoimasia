cabal-version: 3.16
name: hetoimasia-render-2d
version: 0.1.0.0
synopsis: The 2D renderer's frame value, validation, draw plan and instance encoding
description:
    A window's published frame as a pure value: an ordered list of passes, each
    naming its target (the window or an offscreen texture), its clear and its
    ordered views; a view is a camera, a viewport, per-view settings and its
    layers; a layer is a world layer or a UI layer holding its instances in
    submission order. Pure validation turns a candidate snapshot into a
    validated one, or refuses it with every reason found, each naming where it
    was found; nothing is clamped, wrapped or corrected. The application-wide
    discrete-step-zoom list validates the same way. A pure function encodes a
    validated layer's instances into one strict buffer of 64 little-endian
    bytes per instance. A pure draw plan routes each instance of a validated
    snapshot to the cutout or the ordered path, orders a layer's instances and
    splits them into draw runs. Retained chunks (R2D-10) are immutable
    descriptions of static content, built for one kind of layer with their
    routing fixed and their bounds recorded, listed by reference in a layer,
    merged with its dynamic instances by a total order and culled by their
    bounds. An instance names the material it is drawn with by a reference that
    carries the material's declared facts (R2D-11): whether it is
    cutout-capable, the layout of its records and the size of its push block; a
    view and a chunk hold the records and the push blocks, the plan splits runs
    by material and record source, and the encoder writes the records. The
    library depends on hetoimasia-render-api,
    hetoimasia-math and standard libraries only: no GPU, GLFW, Vulkan, runtime
    or Lua package, and no native handle appears in any value. It reads no
    file, performs no IO, owns no state and starts no thread.
license: GPL-3.0-only
license-file: LICENSE
author: Vincent Coghlan
maintainer: Vincent Coghlan
category: Graphics
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files: README.md

source-repository head
    type: git
    location: https://github.com/coghex/hetoimasia.git
    subdir: packages/render-2d

common language
    default-language: GHC2024
    default-extensions: UnicodeSyntax
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import: language
    hs-source-dirs: src
    exposed-modules:
        Hetoimasia.Render.TwoD.Clip
        Hetoimasia.Render.TwoD.Chunk
        Hetoimasia.Render.TwoD.Chunk.Backend
        Hetoimasia.Render.TwoD.Culling
        Hetoimasia.Render.TwoD.DrawPlan
        Hetoimasia.Render.TwoD.Encoding
        Hetoimasia.Render.TwoD.Mapping
        Hetoimasia.Render.TwoD.Material
        Hetoimasia.Render.TwoD.Material.Backend
        Hetoimasia.Render.TwoD.Metrics
        Hetoimasia.Render.TwoD.Settings
        Hetoimasia.Render.TwoD.Snapshot
        Hetoimasia.Render.TwoD.Target
        Hetoimasia.Render.TwoD.Target.Backend
        Hetoimasia.Render.TwoD.Validation
        Hetoimasia.Render.TwoD.ZoomSteps
    -- The finiteness and range tests validation applies, the offscreen target
    -- reference's representation, which only the two target modules import, the
    -- retained chunk's and its reference's, which the chunk modules build and
    -- validation resolves, the material reference's and the data a view holds
    -- for a material, and the routing rule the plan and a chunk share.
    other-modules:
        Hetoimasia.Render.TwoD.Internal.Check
        Hetoimasia.Render.TwoD.Internal.Chunk
        Hetoimasia.Render.TwoD.Internal.ChunkRef
        Hetoimasia.Render.TwoD.Internal.Material
        Hetoimasia.Render.TwoD.Internal.Routing
        Hetoimasia.Render.TwoD.Internal.Target
    build-depends:
        array >=0.5 && <0.6,
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0

-- This package's own contracts, registered as the CPU validation group
-- `test.render-2d`. The library depends on no GPU, GLFW, Vulkan, runtime or
-- Lua package; Hspec, QuickCheck and the external-client compiler harness are
-- the suite's alone.
test-suite render-2d-tests
    import: language
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        Test.Render.TwoD.Clip
        Test.Render.TwoD.Chunks
        Test.Render.TwoD.DrawPlan
        Test.Render.TwoD.Encoding
        Test.Render.TwoD.Flags
        Test.Render.TwoD.Mapping
        Test.Render.TwoD.Materials
        Test.Render.TwoD.Opacity
        Test.Render.TwoD.Snapping
        Test.Render.TwoD.Spec
        Test.Render.TwoD.Support
        Test.Render.TwoD.Validation
        Test.Render.TwoD.ZoomSteps
    build-depends:
        base >=4.22 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.8 && <0.9,
        ghc-heap >=9.14 && <9.15,
        hspec >=2.11 && <3,
        QuickCheck >=2.15 && <2.19,
        hetoimasia-math ==0.1.0.0,
        hetoimasia-render-2d ==0.1.0.0,
        hetoimasia-render-api ==0.1.0.0,
        hetoimasia-test-support ==0.1.0.0
